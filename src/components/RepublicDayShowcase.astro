---
import { withBase } from '../utils/paths';

const archivePhotoSrc = withBase('/images/arsiv/cumhuriyet-tbmm-29-ekim.jpg');
---

<section class="republic-showcase" aria-labelledby="republic-day-heading">
  <div class="republic-showcase__glow republic-showcase__glow--crimson" aria-hidden="true"></div>
  <div class="republic-showcase__glow republic-showcase__glow--gold" aria-hidden="true"></div>

  <div class="container">
    <article class="republic-card reveal">
      <div class="republic-card__content">
        <div class="republic-card__badges">
          <span class="republic-pill republic-pill--crimson">
            <span class="republic-pill__star" aria-hidden="true">★</span>
            29 EKİM CUMHURİYET BAYRAMI · 103. YIL
          </span>
          <span class="republic-pill republic-pill--archive">
            TBMM ZABIT CERİDESİ · KANUN NO: 364 · SAAT 20.30
          </span>
        </div>

        <h2 id="republic-day-heading" class="republic-card__title">
          Tarihi Yapanların, Tarihi Yazanlara Bıraktığı Özgür Akıl Mirası:
          <span>Cumhuriyetimizin 103. Yılı Kutlu Olsun.</span>
        </h2>

        <blockquote class="republic-card__quote">
          <p>
            «Tarih yazmak, tarih yapmak kadar mühimdir. Yazan yapana sadık kalmazsa değişmeyen hakikat, insanlığı
            şaşırtacak bir mahiyet alır.»
          </p>
          <footer>
            <strong>Gazi Mustafa Kemal Atatürk</strong>
            <span>Ankara, Ağustos 1931 · Türk Tarihi Tetkik Cemiyeti’ne Mektup</span>
          </footer>
        </blockquote>

        <p class="republic-card__body">
          <strong>29 Ekim 1923 Pazartesi akşamı saat 20.30’da</strong> Türkiye Büyük Millet Meclisi tutanaklarına
          <em>«Türkiye Devletinin şekl-i Hükûmeti, Cumhuriyettir»</em> hükmü düşüldüğünde yalnızca yeni bir devlet
          düzeni ilan edilmedi; geçmişi efsanelerin ve tek taraflı propagandaların sisinden çıkarıp
          <strong>belgeyle, kanıtla ve eleştirel akılla okuma iradesi</strong> de kurumsallaştı. Birincil kaynakların
          izinde, Cumhuriyetimizin 103. yılını saygı ve minnetle kutluyoruz.
        </p>
      </div>

      <figure class="republic-card__media">
        <div class="republic-card__frame">
          <img
            src={archivePhotoSrc}
            alt="Cumhurbaşkanı Gazi Mustafa Kemal Atatürk, TBMM Başkanı Kâzım Özalp, Başbakan İsmet İnönü ve Mareşal Fevzi Çakmak Cumhuriyet Bayramı töreninde Türkiye Büyük Millet Meclisi'nden çıkarken"
            width="1920"
            height="1360"
            loading="eager"
            decoding="async"
          />
          <span class="republic-card__frame-badge">BİRİNCİL ARŞİV FOTOĞRAFI · 29 EKİM TÖRENİ</span>
        </div>
        <figcaption class="republic-card__caption">
          <strong>Türkiye Büyük Millet Meclisi Önü · Cumhuriyet Bayramı Töreni</strong>
          <span>
            Cumhurbaşkanı Gazi Mustafa Kemal Atatürk, TBMM Başkanı Kâzım Özalp, Başbakan İsmet İnönü ve Mareşal Fevzi
            Çakmak Meclis’ten çıkarken (Ankara, 29 Ekim 1929 · Kamu Malı Arşiv Kaydı)
          </span>
        </figcaption>
      </figure>
    </article>
  </div>
</section>

<style>
  .republic-showcase {
    position: relative;
    padding: 2.6rem 0 0.6rem;
    overflow: hidden;
  }

  .republic-showcase__glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(78px);
    z-index: 0;
  }

  .republic-showcase__glow--crimson {
    top: -120px;
    left: 6%;
    width: 480px;
    height: 320px;
    background: rgba(217, 72, 95, 0.16);
  }

  .republic-showcase__glow--gold {
    bottom: -100px;
    right: 8%;
    width: 440px;
    height: 290px;
    background: rgba(217, 155, 78, 0.13);
  }

  .republic-card {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(0, 0.94fr);
    gap: 2.4rem;
    align-items: center;
    padding: 2.35rem 2.5rem;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, rgba(28, 17, 24, 0.86) 0%, rgba(16, 19, 28, 0.95) 52%, rgba(20, 22, 31, 0.96) 100%);
    border: 1px solid rgba(217, 72, 95, 0.34);
    box-shadow:
      0 26px 68px rgba(0, 0, 0, 0.56),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .republic-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(125deg, rgba(217, 72, 95, 0.55), rgba(217, 155, 78, 0.42), rgba(255, 255, 255, 0.04));
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .republic-card__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.05rem;
  }

  .republic-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.34rem 0.78rem;
    border-radius: 999px;
    font-size: 0.71rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .republic-pill--crimson {
    background: rgba(217, 72, 95, 0.18);
    border: 1px solid rgba(217, 72, 95, 0.48);
    color: #ff98a8;
  }

  .republic-pill__star {
    color: #f5c27a;
    font-size: 0.78rem;
  }

  .republic-pill--archive {
    background: rgba(217, 155, 78, 0.1);
    border: 1px solid rgba(217, 155, 78, 0.3);
    color: var(--accent-gold);
  }

  .republic-card__title {
    font-size: clamp(1.75rem, 2.75vw, 2.5rem);
    line-height: 1.18;
    margin-bottom: 1.15rem;
    color: var(--text-primary);
  }

  .republic-card__title span {
    display: block;
    margin-top: 0.25rem;
    color: var(--accent-gold);
    font-style: italic;
    font-weight: 600;
  }

  .republic-card__quote {
    margin: 0 0 1.15rem;
    padding: 0.95rem 1.2rem;
    border-left: 3px solid var(--accent-crimson);
    background: rgba(9, 11, 16, 0.56);
    border-radius: 0 12px 12px 0;
  }

  .republic-card__quote p {
    margin: 0 0 0.48rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.12rem, 1.45vw, 1.28rem);
    line-height: 1.48;
    color: var(--text-primary);
  }

  .republic-card__quote footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.75rem;
    font-size: 0.77rem;
  }

  .republic-card__quote strong {
    color: var(--accent-gold);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .republic-card__quote span {
    color: var(--text-muted);
  }

  .republic-card__body {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.74;
    color: var(--text-secondary);
  }

  .republic-card__body strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .republic-card__body em {
    color: #f3d5a5;
    font-style: italic;
  }

  .republic-card__media {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
  }

  .republic-card__frame {
    position: relative;
    border-radius: 13px;
    overflow: hidden;
    aspect-ratio: 1920 / 1360;
    background: #0b0d13;
    border: 1px solid rgba(217, 155, 78, 0.34);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.55);
  }

  .republic-card__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at center, transparent 58%, rgba(8, 9, 13, 0.42) 100%),
      linear-gradient(to top, rgba(8, 9, 13, 0.52) 0%, transparent 26%);
    pointer-events: none;
  }

  .republic-card__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.2) contrast(1.06) brightness(0.95);
    transition: transform 0.55s ease, filter 0.4s ease;
  }

  .republic-card:hover .republic-card__frame img {
    transform: scale(1.018);
    filter: sepia(0.14) contrast(1.08) brightness(0.98);
  }

  .republic-card__frame-badge {
    position: absolute;
    bottom: 0.78rem;
    right: 0.78rem;
    z-index: 2;
    padding: 0.28rem 0.66rem;
    border-radius: 999px;
    background: rgba(9, 10, 15, 0.84);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(217, 155, 78, 0.38);
    color: var(--accent-gold);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .republic-card__caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-inline: 0.2rem;
  }

  .republic-card__caption strong {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .republic-card__caption span {
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .republic-showcase {
      padding: 1.6rem 0 0.25rem;
    }

    .republic-card {
      grid-template-columns: 1fr;
      gap: 1.65rem;
      padding: 1.65rem 1.45rem;
    }
  }

  @media (max-width: 560px) {
    .republic-card {
      padding: 1.35rem 1.15rem;
    }

    .republic-pill {
      font-size: 0.61rem;
      letter-spacing: 0.06em;
      padding: 0.28rem 0.6rem;
    }

    .republic-card__frame-badge {
      font-size: 0.56rem;
      letter-spacing: 0.07em;
      padding: 0.22rem 0.52rem;
      bottom: 0.52rem;
      right: 0.52rem;
    }
  }
</style>
