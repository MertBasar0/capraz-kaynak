---
export interface SceneItem {
  id: string;
  shortLabel: string;
}

interface Props {
  scenes?: SceneItem[];
}

const defaultScenes: SceneItem[] = [
  { id: 'prolog', shortLabel: 'Giriş' },
  { id: 'sahne-harita', shortLabel: '01 · Rota & Kuşatma' },
  { id: 'sahne-propaganda', shortLabel: '02 · Propaganda & Olgu' },
  { id: 'sahne-ordu', shortLabel: '03 · Kürboğa & Ordu' },
  { id: 'sahne-kopru-kapisi', shortLabel: '04 · 28 Haziran 1098' },
  { id: 'sahne-ihanet', shortLabel: '05 · İhanetin Bedeli' },
  { id: 'sahne-bilanco', shortLabel: '06 · 200 Yıllık Terazi' },
];

const { scenes = defaultScenes } = Astro.props;
---

<aside class="scene-compass" aria-label="Sahne Gezinme Pusulası">
  <ul>
    {
      scenes.map((scene) => (
        <li>
          <a href={`#${scene.id}`} data-compass-link={scene.id} class="scene-compass__item">
            <span class="scene-compass__label">{scene.shortLabel}</span>
            <span class="scene-compass__dot" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<script>
  let compassCleanup: (() => void) | null = null;

  function initCompass() {
    if (compassCleanup) {
      compassCleanup();
      compassCleanup = null;
    }

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-compass-link]'));
    if (!links.length) return;

    const sections = links
      .map((link) => {
        const id = link.dataset.compassLink;
        return id ? document.getElementById(id) : null;
      })
      .filter((el): el is HTMLElement => Boolean(el));

    const updateActive = () => {
      const triggerY = window.scrollY + window.innerHeight * 0.36;
      let currentId = sections[0]?.id || '';
      for (const sec of sections) {
        if (sec.offsetTop <= triggerY) {
          currentId = sec.id;
        }
      }
      links.forEach((l) => {
        l.classList.toggle('is-active', l.dataset.compassLink === currentId);
      });
    };

    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();

    compassCleanup = () => {
      window.removeEventListener('scroll', updateActive);
    };
  }

  document.addEventListener('astro:page-load', initCompass);
  document.addEventListener('astro:before-swap', () => {
    if (compassCleanup) {
      compassCleanup();
      compassCleanup = null;
    }
  });
</script>

<style>
  .scene-compass {
    position: fixed;
    right: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 75;
    padding: 0.65rem 0.45rem;
    border-radius: 999px;
    background: rgba(11, 13, 20, 0.78);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
  }

  .scene-compass ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .scene-compass__item {
    position: relative;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 600;
    transition: color 0.25s ease;
  }

  .scene-compass__label {
    position: absolute;
    right: calc(100% + 10px);
    padding: 0.28rem 0.65rem;
    border-radius: 8px;
    background: rgba(11, 13, 20, 0.94);
    border: 1px solid var(--border-gold);
    color: var(--text-primary);
    opacity: 0;
    transform: translateX(6px);
    transition: all 0.2s ease;
    white-space: nowrap;
    pointer-events: none;
  }

  .scene-compass__item:hover .scene-compass__label {
    opacity: 1;
    transform: translateX(0);
  }

  .scene-compass__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(243, 237, 226, 0.24);
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .scene-compass__item:hover {
    color: var(--text-primary);
  }

  .scene-compass__item.is-active {
    color: var(--accent-gold);
  }

  .scene-compass__item.is-active .scene-compass__dot {
    background: var(--accent-gold);
    box-shadow: 0 0 12px rgba(217, 155, 78, 0.85);
    transform: scale(1.3);
  }

  @media (max-width: 1120px) {
    .scene-compass {
      display: none;
    }
  }
</style>
