---
import {
  propagandaCases as defaultCases,
  verifiedViolenceFacts as defaultFacts,
  type PropagandaCase,
  type VisualAsset,
} from '../data/antakya1098';

interface Props {
  eyebrow?: string;
  title?: string;
  leadHtml?: string;
  cases?: PropagandaCase[];
  spotlightVisual?: VisualAsset;
  verifiedBox?: {
    pill: string;
    title: string;
    leadHtml: string;
    facts: { title: string; sources: string; detail: string }[];
  };
}

const {
  eyebrow = 'SAHNE 02 · KAYNAK KRİTİĞİ VE ÇAPRAZ SORGU',
  title = 'Dehşet Edebiyatı mı, Tarihsel Olgu mu?',
  leadHtml =
    'Ortaçağ Avrupa’sında yüz binlerce insanı yola çıkarmak için güçlü bir öfke yakıtı gerekiyordu. Aşağıdaki dört ünlü anlatının her birinde <strong>"Dönemin İddiası"</strong> ile <strong>"Birincil Kaynak Kritiği"</strong> arasında geçiş yaparak metinlerin nasıl kurgulandığını inceleyin.',
  cases = defaultCases,
  spotlightVisual,
  verifiedBox = {
    pill: 'DÜRÜST TARİHÇİLİK İLKESİ · DOĞRULANABİLEN SOMUT ŞİDDET',
    title: 'Peki Propaganda Kabuğu Soyulduğunda Gerçekte Ne Yaşandı?',
    leadHtml:
      'Savaş propagandasını ayıklamak, "hiç kan dökülmedi" demek değildir. Ermeni, Bizans, İslam vekâyinâmeleri ve Mısır’daki <strong>Kahire Genizası</strong> tüccar mektupları şu üç sert tarihsel olguyu kesin olarak doğrular:',
    facts: defaultFacts,
  },
} = Astro.props;
---

<section id="sahne-propaganda" class="section-shell propaganda-section">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="section-title">{title}</h2>
      <p class="section-lead" set:html={leadHtml} />

      <div class="lens-master-bar">
        <button type="button" class="lens-master-btn" id="toggle-all-lenses" data-all-open="false">
          <span class="lens-master-icon" aria-hidden="true">⌕</span>
          <span id="toggle-all-lenses-text">Tüm Kartlarda Kaynak Kritiği Perdesini Aç</span>
        </button>
      </div>
    </div>

    {
      spotlightVisual && (
        <figure class="lens-spotlight reveal">
          <div
            class:list={[
              'lens-spotlight__frame',
              { 'lens-spotlight__frame--contain': spotlightVisual.objectFit === 'contain' },
            ]}
          >
            <img
              src={spotlightVisual.src}
              alt={spotlightVisual.caption}
              class:list={[
                'lens-spotlight__img',
                {
                  'is-engraving': spotlightVisual.isEngraving,
                  'lens-spotlight__img--contain': spotlightVisual.objectFit === 'contain',
                },
              ]}
              style={`object-position: ${spotlightVisual.objectPosition || 'center'}`}
              loading="lazy"
            />
            <span class="lens-spotlight__badge">{spotlightVisual.badge}</span>
          </div>
          <figcaption class="lens-spotlight__cap">
            <strong>{spotlightVisual.caption}</strong>
            <span>{spotlightVisual.credit}</span>
          </figcaption>
        </figure>
      )
    }

    <div class="propaganda-grid">
      {
        cases.map((item, idx) => (
          <article
            class="lens-card reveal"
            style={`--delay: ${idx * 70}ms`}
            data-lens-card
            data-mode="claim"
          >
            <div class="lens-card__top">
              <span class="lens-card__badge">{item.badge}</span>
              <span class="pill pill--west">{item.verdict}</span>
            </div>

            <h3 class="lens-card__title">{item.title}</h3>

            <div class="lens-stage">
              <div class="lens-pane lens-pane--claim">
                <div class="lens-pane__tag">{item.claimTag || 'BATI METNİNDEKİ İDDİA / KURGU KATMANI'}</div>
                <div class="lens-pane__source">{item.claimSource}</div>
                <blockquote class="lens-pane__quote">{item.claimQuote}</blockquote>
              </div>

              <div class="lens-pane lens-pane--critique">
                <div class="lens-pane__tag lens-pane__tag--truth">ÇAPRAZ BİRİNCİL KAYNAK DENETİMİ</div>
                <div class="lens-pane__source">{item.critiqueSource}</div>
                <p class="lens-pane__analysis">{item.critiqueAnalysis}</p>
              </div>
            </div>

            <button type="button" class="lens-switch-btn" data-lens-trigger>
              <span data-lens-btn-label>Perdeyi Arala: Birincil Kaynak Kritiğini Gör →</span>
            </button>
          </article>
        ))
      }
    </div>

    <div class="verified-box reveal">
      <div class="verified-box__header">
        <span class="pill pill--witness">{verifiedBox.pill}</span>
        <h3>{verifiedBox.title}</h3>
        <p set:html={verifiedBox.leadHtml} />
      </div>

      <div class="verified-grid">
        {
          verifiedBox.facts.map((fact) => (
            <div class="verified-item">
              <h4>{fact.title}</h4>
              <div class="verified-item__src">Kanıt: {fact.sources}</div>
              <p>{fact.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function initPropagandaLens() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-lens-card]'));
    const masterBtn = document.getElementById('toggle-all-lenses');
    const masterText = document.getElementById('toggle-all-lenses-text');

    const setCardMode = (card: HTMLElement, mode: 'claim' | 'critique') => {
      card.dataset.mode = mode;
      const label = card.querySelector('[data-lens-btn-label]');
      if (label) {
        label.textContent =
          mode === 'critique'
            ? '← İddia / Kurgu Metnine Geri Dön'
            : 'Perdeyi Arala: Birincil Kaynak Kritiğini Gör →';
      }
    };

    cards.forEach((card) => {
      const btn = card.querySelector<HTMLButtonElement>('[data-lens-trigger]');
      btn?.addEventListener('click', () => {
        const next = card.dataset.mode === 'critique' ? 'claim' : 'critique';
        setCardMode(card, next);
      });
    });

    masterBtn?.addEventListener('click', () => {
      const isAllOpen = masterBtn.dataset.allOpen === 'true';
      const targetMode = isAllOpen ? 'claim' : 'critique';
      cards.forEach((c) => setCardMode(c, targetMode));
      masterBtn.dataset.allOpen = String(!isAllOpen);
      if (masterText) {
        masterText.textContent = !isAllOpen
          ? 'Tüm Kartları İddia Görünümüne Döndür'
          : 'Tüm Kartlarda Kaynak Kritiği Perdesini Aç';
      }
    });
  }

  document.addEventListener('astro:page-load', initPropagandaLens);
</script>

<style>
  .lens-master-bar {
    margin-top: 1.5rem;
  }

  .lens-master-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.72rem 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--border-gold);
    background: var(--accent-gold-soft);
    color: var(--accent-gold);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.22s ease;
  }

  .lens-master-btn:hover {
    background: rgba(217, 155, 78, 0.25);
    transform: translateY(-1px);
  }

  .lens-spotlight {
    margin: 0 0 2.2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border-gold);
    box-shadow: var(--shadow-deep);
  }

  .lens-spotlight__frame {
    position: relative;
    height: clamp(200px, 28vw, 310px);
    overflow: hidden;
    background: #141210;
  }

  .lens-spotlight__frame--contain {
    height: clamp(300px, 38vw, 410px);
    background: radial-gradient(ellipse at center, #231d16 0%, #0f0d0a 100%);
  }

  .lens-spotlight__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lens-spotlight__img--contain {
    object-fit: contain;
    padding: 0.95rem 1rem;
  }

  @media (max-width: 640px) {
    .lens-spotlight__img--contain {
      padding: 2.45rem 0.75rem 0.8rem;
    }
  }

  .lens-spotlight__img.is-engraving {
    filter: sepia(0.26) contrast(1.08) brightness(0.9);
  }

  .lens-spotlight__badge {
    position: absolute;
    top: 0.85rem;
    left: 0.95rem;
    padding: 0.3rem 0.72rem;
    border-radius: 999px;
    background: rgba(8, 10, 15, 0.86);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-gold);
    color: var(--accent-gold);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.11em;
  }

  .lens-spotlight__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.2rem;
    padding: 0.82rem 1.2rem;
    background: rgba(14, 18, 27, 0.96);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
  }

  .lens-spotlight__cap strong {
    color: var(--text-primary);
  }

  .lens-spotlight__cap span {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .propaganda-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .lens-card {
    display: flex;
    flex-direction: column;
    padding: 1.65rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-deep);
    transition: border-color 0.35s ease, transform 0.3s ease;
  }

  .lens-card[data-mode='critique'] {
    border-color: rgba(44, 197, 179, 0.45);
    background: linear-gradient(165deg, rgba(16, 31, 34, 0.9), rgba(16, 20, 29, 0.92));
  }

  .lens-card__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .lens-card__badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .lens-card__title {
    font-size: 1.5rem;
    margin-bottom: 1.15rem;
  }

  .lens-stage {
    position: relative;
    flex: 1;
    min-height: 225px;
    margin-bottom: 1.25rem;
  }

  .lens-pane {
    transition: opacity 0.38s ease, transform 0.38s ease;
  }

  .lens-card[data-mode='claim'] .lens-pane--critique {
    display: none;
  }

  .lens-card[data-mode='critique'] .lens-pane--claim {
    display: none;
  }

  .lens-pane__tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    color: var(--accent-crimson);
    margin-bottom: 0.3rem;
  }

  .lens-pane__tag--truth {
    color: var(--accent-turquoise);
  }

  .lens-pane__source {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    opacity: 0.9;
  }

  .lens-pane__quote {
    margin: 0;
    padding: 1rem 1.1rem;
    border-left: 3px solid var(--accent-crimson);
    background: rgba(217, 72, 95, 0.06);
    border-radius: 0 10px 10px 0;
    font-family: var(--font-serif);
    font-size: 1.13rem;
    font-style: italic;
    line-height: 1.58;
    color: var(--text-primary);
  }

  .lens-pane__analysis {
    margin: 0;
    padding: 1rem 1.1rem;
    border-left: 3px solid var(--accent-turquoise);
    background: rgba(44, 197, 179, 0.07);
    border-radius: 0 10px 10px 0;
    font-size: 0.94rem;
    line-height: 1.7;
    color: var(--text-primary);
  }

  .lens-switch-btn {
    width: 100%;
    padding: 0.78rem 1rem;
    border-radius: 10px;
    border: 1px solid rgba(243, 237, 226, 0.14);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.83rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.22s ease;
  }

  .lens-switch-btn:hover {
    border-color: var(--accent-turquoise);
    color: var(--accent-turquoise);
    background: rgba(44, 197, 179, 0.09);
  }

  .verified-box {
    padding: 2.2rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, rgba(24, 21, 36, 0.86), rgba(15, 18, 27, 0.92));
    border: 1px solid rgba(167, 139, 250, 0.28);
  }

  .verified-box__header h3 {
    font-size: 1.85rem;
    margin: 0.8rem 0 0.6rem;
  }

  .verified-box__header p {
    max-width: 820px;
    margin-bottom: 1.6rem;
  }

  .verified-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .verified-item {
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(8, 9, 13, 0.55);
    border: 1px solid var(--border-subtle);
  }

  .verified-item h4 {
    font-size: 1.22rem;
    margin-bottom: 0.35rem;
    color: var(--text-primary);
  }

  .verified-item__src {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-witness);
    margin-bottom: 0.65rem;
  }

  .verified-item p {
    font-size: 0.88rem;
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 940px) {
    .propaganda-grid,
    .verified-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
