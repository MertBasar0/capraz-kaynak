---
import { otherFronts, balanceRows, primarySourcesGuide } from '../data/antakya1098';
---

<section id="sahne-bilanco" class="section-shell">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">SAHNE 06 · 200 YILLIK PANORAMA VE TARİHSEL TERAZİ (1099 – 1291)</span>
      <h2 class="section-title">Yalnızca Türkler mi Savaştı? Ve Gerçekte Kim Kazandı?</h2>
      <p class="section-lead">
        <em>"Haçlılarla 200 yıl kesintisiz ve yalnızca Türkler savaştı"</em> söylemi diğer büyük aktörleri görünmez
        kılan bir sadeleştirmedir; ancak <em>"Türkler bu mücadelenin ana kalkanı ve tasfiye edici omurgasıydı"</em>
        tespiti somut bir tarihsel gerçektir.
      </p>
    </div>

    <!-- 5 CEPHE SEKMELİ KEŞİF PANOSU -->
    <div class="fronts-explorer reveal">
      <div class="fronts-tabs" role="tablist" aria-label="Haçlı Seferleri Cephe Aktörleri">
        {
          otherFronts.map((front, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              class:list={['front-tab', { 'is-active': idx === 0 }]}
              data-front-tab={front.id}
            >
              {front.tabTitle}
            </button>
          ))
        }
      </div>

      <div class="fronts-panels">
        {
          otherFronts.map((front, idx) => (
            <div
              class:list={['front-panel', { 'is-active': idx === 0 }]}
              data-front-panel={front.id}
              role="tabpanel"
            >
              <div class="front-panel__period">{front.period}</div>
              <h3>{front.tabTitle}</h3>
              <p class="front-panel__summary">{front.summary}</p>
              <div class="front-panel__fact">
                <strong>Kritik Tarihsel Kayıt:</strong> {front.keyFact}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- GÖRÜNÜR VE GİZLİ HEDEFLER TERAZİSİ -->
    <div class="balance-wrap reveal">
      <div class="balance-wrap__head">
        <span class="pill pill--east">GÖRÜNÜR DAVALAR ↔ ARKA PLANDAKİ SONUÇLAR</span>
        <h3>Geçmişten Günümüze Büyük Bilanço</h3>
        <p>
          Haçlılar uğruna yola çıktıkları <strong>görünürdeki hedeflerin tamamında yenildiler</strong>, ancak arka
          plandaki ekonomik ve siyasi dönüşümle <strong>Yeni Çağ Avrupa’sının temellerini attılar</strong>. Türkler ise
          sahadaki varlık ve coğrafya davasını kesin biçimde kazandı.
        </p>
      </div>

      <div class="balance-table">
        {
          balanceRows.map((row) => (
            <div class="balance-row">
              <div class="balance-dim">
                <span>DEĞERLENDİRME BOYUTU</span>
                <h4>{row.dimension}</h4>
              </div>

              <div class="balance-cell balance-cell--west">
                <div class="balance-verdict">{row.crusadersVerdict}</div>
                <div class="balance-side">HAÇLI KOALİSYONU</div>
                <p>{row.crusadersDetail}</p>
              </div>

              <div class="balance-cell balance-cell--east">
                <div class="balance-verdict balance-verdict--east">{row.turksVerdict}</div>
                <div class="balance-side">TÜRKLER (SELÇUKLU · ZENGÎ · MEMLÛK)</div>
                <p>{row.turksDetail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- AÇIK BİRİNCİL KAYNAKÇA KÜTÜPHANESİ -->
    <details class="sources-drawer reveal">
      <summary>
        <div>
          <span class="pill pill--witness">ŞEFFAF KAYNAKÇA</span>
          <strong>Bu Dosyada Başvurulan Birincil Vekâyinâmeler ve Arşiv Belgeleri (Tıklayıp İnceleyin)</strong>
        </div>
        <span class="sources-drawer__chevron">▾</span>
      </summary>

      <div class="sources-grid">
        {
          primarySourcesGuide.map((src) => (
            <div class="source-item">
              <h4>{src.name}</h4>
              <span class="source-side">{src.side}</span>
              <p>{src.desc}</p>
            </div>
          ))
        }
      </div>

      <p class="modern-refs">
        <strong>Başlıca Modern Akademik Başvuru Eserleri:</strong> Işın Demirkent (<em>Haçlı Seferleri Tarihi</em>,
        <em>Urfa Haçlı Kontluğu</em>), Abdülkerim Özaydın (<em>Sultan Berkyaruk Devri Selçuklu Tarihi</em>, TDV İA
        <em>"Kürboğa"</em>), Ali Sevim (<em>Suriye ve Filistin Selçukluları Tarihi</em>), Claude Cahen (<em>Osmanlılardan
        Önce Anadolu</em>), Carole Hillenbrand (<em>The Crusades: Islamic Perspectives</em>), John France (<em>Victory
        in the East</em>), Jonathan Riley-Smith, Thomas Asbridge ve Peter Frankopan.
      </p>
    </details>
  </div>
</section>

<script>
  function initBalanceTabs() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-front-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-front-panel]'));

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.frontTab;
        tabs.forEach((t) => {
          const active = t.dataset.frontTab === id;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
        });
        panels.forEach((p) => {
          p.classList.toggle('is-active', p.dataset.frontPanel === id);
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initBalanceTabs);
</script>

<style>
  .fronts-explorer {
    margin-bottom: 3rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .fronts-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.85rem;
    background: rgba(8, 9, 13, 0.72);
    border-bottom: 1px solid var(--border-subtle);
  }

  .front-tab {
    padding: 0.65rem 1.05rem;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.83rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .front-tab:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.04);
  }

  .front-tab.is-active {
    color: var(--accent-gold);
    background: var(--accent-gold-soft);
    border-color: var(--border-gold);
  }

  .fronts-panels {
    padding: 2rem;
  }

  .front-panel {
    display: none;
  }

  .front-panel.is-active {
    display: block;
    animation: fadeSlide 0.32s ease;
  }

  @keyframes fadeSlide {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .front-panel__period {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-turquoise);
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .front-panel h3 {
    font-size: 1.95rem;
    margin-bottom: 0.85rem;
  }

  .front-panel__summary {
    font-size: 1rem;
    line-height: 1.78;
    max-width: 900px;
    color: var(--text-primary);
    margin-bottom: 1.2rem;
  }

  .front-panel__fact {
    padding: 1rem 1.2rem;
    border-radius: var(--radius-md);
    background: rgba(44, 197, 179, 0.08);
    border-left: 3px solid var(--accent-turquoise);
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  /* Balance Matrix */
  .balance-wrap {
    margin-bottom: 3rem;
  }

  .balance-wrap__head {
    max-width: 820px;
    margin-bottom: 1.8rem;
  }

  .balance-wrap__head h3 {
    font-size: 2.1rem;
    margin: 0.75rem 0 0.6rem;
  }

  .balance-table {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .balance-row {
    display: grid;
    grid-template-columns: 0.85fr 1.1fr 1.1fr;
    gap: 1rem;
    padding: 1.35rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
  }

  .balance-dim {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: 0.5rem;
  }

  .balance-dim span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .balance-dim h4 {
    font-size: 1.4rem;
  }

  .balance-cell {
    padding: 1.15rem 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(8, 9, 13, 0.55);
    border: 1px solid var(--border-subtle);
  }

  .balance-cell--west {
    border-left: 3px solid var(--accent-crimson);
  }

  .balance-cell--east {
    border-left: 3px solid var(--accent-turquoise);
  }

  .balance-verdict {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    color: #ff8196;
    margin-bottom: 0.18rem;
  }

  .balance-verdict--east {
    color: var(--accent-turquoise);
  }

  .balance-side {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 0.55rem;
  }

  .balance-cell p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.62;
    color: var(--text-primary);
  }

  /* Sources Drawer */
  .sources-drawer {
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 1.35rem 1.75rem;
  }

  .sources-drawer summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
  }

  .sources-drawer summary::-webkit-details-marker {
    display: none;
  }

  .sources-drawer summary div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .sources-drawer__chevron {
    font-size: 1.25rem;
    color: var(--accent-gold);
    transition: transform 0.25s ease;
  }

  .sources-drawer[open] .sources-drawer__chevron {
    transform: rotate(180deg);
  }

  .sources-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .source-item {
    padding: 1.1rem;
    border-radius: var(--radius-md);
    background: rgba(8, 9, 13, 0.55);
    border: 1px solid var(--border-subtle);
  }

  .source-item h4 {
    font-size: 1.2rem;
    margin-bottom: 0.2rem;
  }

  .source-side {
    display: block;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
  }

  .source-item p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .modern-refs {
    margin: 1.35rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  @media (max-width: 960px) {
    .balance-row,
    .sources-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
