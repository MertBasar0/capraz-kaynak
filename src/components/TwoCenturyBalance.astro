---
import {
  otherFronts as defaultFronts,
  balanceRows as defaultBalanceRows,
  primarySourcesGuide as defaultSources,
  type VisualAsset,
} from '../data/antakya1098';

interface Props {
  eyebrow?: string;
  title?: string;
  leadHtml?: string;
  explorerVisual?: VisualAsset;
  tabsAriaLabel?: string;
  fronts?: typeof defaultFronts;
  philologySpotlight?: {
    badge: string;
    title: string;
    eastLabel: string;
    eastSource: string;
    eastText: string;
    westLabel: string;
    westSource: string;
    westText: string;
    resolutionHtml: string;
  };
  balanceHeader?: {
    pill: string;
    title: string;
    leadHtml: string;
    westSideLabel?: string;
    eastSideLabel?: string;
  };
  rows?: typeof defaultBalanceRows;
  sourcesTitle?: string;
  sources?: typeof defaultSources;
  modernRefsHtml?: string;
}

const {
  eyebrow = 'SAHNE 06 · 200 YILLIK PANORAMA VE TARİHSEL TERAZİ (1099 – 1291)',
  title = 'Yalnızca Türkler mi Savaştı? Ve Gerçekte Kim Kazandı?',
  leadHtml =
    '<em>"Haçlılarla 200 yıl kesintisiz ve yalnızca Türkler savaştı"</em> söylemi diğer büyük aktörleri görünmez kılan bir sadeleştirmedir; ancak <em>"Türkler bu mücadelenin ana kalkanı ve tasfiye edici omurgasıydı"</em> tespiti somut bir tarihsel gerçektir.',
  explorerVisual,
  tabsAriaLabel = 'Haçlı Seferleri Cephe Aktörleri',
  fronts = defaultFronts,
  philologySpotlight,
  balanceHeader = {
    pill: 'GÖRÜNÜR DAVALAR ↔ ARKA PLANDAKİ SONUÇLAR',
    title: 'Geçmişten Günümüze Büyük Bilanço',
    leadHtml:
      'Haçlılar uğruna yola çıktıkları <strong>görünürdeki hedeflerin tamamında yenildiler</strong>, ancak arka plandaki ekonomik ve siyasi dönüşümle <strong>Yeni Çağ Avrupa’sının temellerini attılar</strong>. Türkler ise sahadaki varlık ve coğrafya davasını kesin biçimde kazandı.',
    westSideLabel: 'HAÇLI KOALİSYONU',
    eastSideLabel: 'TÜRKLER (SELÇUKLU · ZENGÎ · MEMLÛK)',
  },
  rows = defaultBalanceRows,
  sourcesTitle = 'Bu Dosyada Başvurulan Birincil Vekâyinâmeler ve Arşiv Belgeleri (Tıklayıp İnceleyin)',
  sources = defaultSources,
  modernRefsHtml =
    '<strong>Başlıca Modern Akademik Başvuru Eserleri:</strong> Işın Demirkent (<em>Haçlı Seferleri Tarihi</em>, <em>Urfa Haçlı Kontluğu</em>), Abdülkerim Özaydın (<em>Sultan Berkyaruk Devri Selçuklu Tarihi</em>, TDV İA <em>"Kürboğa"</em>), Ali Sevim (<em>Suriye ve Filistin Selçukluları Tarihi</em>), Claude Cahen (<em>Osmanlılardan Önce Anadolu</em>), Carole Hillenbrand (<em>The Crusades: Islamic Perspectives</em>), John France (<em>Victory in the East</em>), Jonathan Riley-Smith, Thomas Asbridge ve Peter Frankopan.',
} = Astro.props;
---

<section id="sahne-bilanco" class="section-shell">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="section-title">{title}</h2>
      <p class="section-lead" set:html={leadHtml} />
    </div>

    {
      explorerVisual && (
        <figure class="explorer-banner reveal">
          <div class="explorer-banner__frame">
            <img
              src={explorerVisual.src}
              alt={explorerVisual.caption}
              class:list={['explorer-banner__img', { 'is-engraving': explorerVisual.isEngraving }]}
              style={`object-position: ${explorerVisual.objectPosition || 'center'}`}
              loading="lazy"
            />
            <span class="explorer-banner__badge">{explorerVisual.badge}</span>
          </div>
          <figcaption class="explorer-banner__cap">
            <strong>{explorerVisual.caption}</strong>
            <span>{explorerVisual.credit}</span>
          </figcaption>
        </figure>
      )
    }

    <!-- SEKMELİ KEŞİF PANOSU -->
    <div class="fronts-explorer reveal">
      <div class="fronts-tabs" role="tablist" aria-label={tabsAriaLabel}>
        {
          fronts.map((front, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              class:list={['front-tab', { 'is-active': idx === 0 }]}
              data-front-tab={front.id}
            >
              {front.tabTitle}
            </button>
          ))
        }
      </div>

      <div class="fronts-panels">
        {
          fronts.map((front, idx) => (
            <div
              class:list={['front-panel', { 'is-active': idx === 0 }]}
              data-front-panel={front.id}
              role="tabpanel"
            >
              <div class="front-panel__period">{front.period}</div>
              <h3>{front.tabTitle}</h3>
              <p class="front-panel__summary">{front.summary}</p>
              <div class="front-panel__fact">
                <strong>Kritik Tarihsel Kayıt:</strong> {front.keyFact}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {
      philologySpotlight && (
        <div class="philology-box reveal">
          <div class="philology-box__head">
            <span class="pill pill--witness">{philologySpotlight.badge}</span>
            <h3>{philologySpotlight.title}</h3>
          </div>

          <div class="philology-cols">
            <div class="philology-col philology-col--east">
              <span class="philology-col__tag">{philologySpotlight.eastLabel}</span>
              <strong>{philologySpotlight.eastSource}</strong>
              <p>{philologySpotlight.eastText}</p>
            </div>
            <div class="philology-col philology-col--west">
              <span class="philology-col__tag philology-col__tag--west">{philologySpotlight.westLabel}</span>
              <strong>{philologySpotlight.westSource}</strong>
              <p>{philologySpotlight.westText}</p>
            </div>
          </div>

          <div class="philology-resolution" set:html={philologySpotlight.resolutionHtml} />
        </div>
      )
    }

    <!-- GÖRÜNÜR VE GİZLİ HEDEFLER TERAZİSİ -->
    <div class="balance-wrap reveal">
      <div class="balance-wrap__head">
        <span class="pill pill--east">{balanceHeader.pill}</span>
        <h3>{balanceHeader.title}</h3>
        <p set:html={balanceHeader.leadHtml} />
      </div>

      <div class="balance-table">
        {
          rows.map((row) => (
            <div class="balance-row">
              <div class="balance-dim">
                <span>DEĞERLENDİRME BOYUTU</span>
                <h4>{row.dimension}</h4>
              </div>

              <div class="balance-cell balance-cell--west">
                <div class="balance-verdict">{row.crusadersVerdict}</div>
                <div class="balance-side">{balanceHeader.westSideLabel || 'HAÇLI KOALİSYONU'}</div>
                <p>{row.crusadersDetail}</p>
              </div>

              <div class="balance-cell balance-cell--east">
                <div class="balance-verdict balance-verdict--east">{row.turksVerdict}</div>
                <div class="balance-side">
                  {balanceHeader.eastSideLabel || 'TÜRKLER (SELÇUKLU · ZENGÎ · MEMLÛK)'}
                </div>
                <p>{row.turksDetail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- AÇIK BİRİNCİL KAYNAKÇA KÜTÜPHANESİ -->
    <details class="sources-drawer reveal">
      <summary>
        <div>
          <span class="pill pill--witness">ŞEFFAF KAYNAKÇA</span>
          <strong>{sourcesTitle}</strong>
        </div>
        <span class="sources-drawer__chevron">▾</span>
      </summary>

      <div class="sources-grid">
        {
          sources.map((src) => (
            <div class="source-item">
              <h4>{src.name}</h4>
              <span class="source-side">{src.side}</span>
              <p>{src.desc}</p>
            </div>
          ))
        }
      </div>

      <p class="modern-refs" set:html={modernRefsHtml} />
    </details>
  </div>
</section>

<script>
  function initBalanceTabs() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-front-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-front-panel]'));

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.frontTab;
        tabs.forEach((t) => {
          const active = t.dataset.frontTab === id;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
        });
        panels.forEach((p) => {
          p.classList.toggle('is-active', p.dataset.frontPanel === id);
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initBalanceTabs);
</script>

<style>
  .explorer-banner {
    margin: 0 0 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border-gold);
    box-shadow: var(--shadow-deep);
  }

  .explorer-banner__frame {
    position: relative;
    height: clamp(230px, 32vw, 370px);
    overflow: hidden;
    background: #090b10;
  }

  .explorer-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .explorer-banner__img.is-engraving {
    filter: sepia(0.26) contrast(1.08) brightness(0.9);
  }

  .explorer-banner__badge {
    position: absolute;
    top: 0.9rem;
    left: 0.95rem;
    padding: 0.3rem 0.72rem;
    border-radius: 999px;
    background: rgba(8, 10, 15, 0.86);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-gold);
    color: var(--accent-gold);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .explorer-banner__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.2rem;
    padding: 0.82rem 1.2rem;
    background: rgba(14, 18, 27, 0.96);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
  }

  .explorer-banner__cap strong {
    color: var(--text-primary);
  }

  .explorer-banner__cap span {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .fronts-explorer {
    margin-bottom: 3rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .fronts-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.85rem;
    background: rgba(8, 9, 13, 0.72);
    border-bottom: 1px solid var(--border-subtle);
  }

  .front-tab {
    padding: 0.65rem 1.05rem;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.83rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .front-tab:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.04);
  }

  .front-tab.is-active {
    color: var(--accent-gold);
    background: var(--accent-gold-soft);
    border-color: var(--border-gold);
  }

  .fronts-panels {
    padding: 2rem;
  }

  .front-panel {
    display: none;
  }

  .front-panel.is-active {
    display: block;
    animation: fadeSlide 0.32s ease;
  }

  @keyframes fadeSlide {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .front-panel__period {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-turquoise);
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .front-panel h3 {
    font-size: 1.95rem;
    margin-bottom: 0.85rem;
  }

  .front-panel__summary {
    font-size: 1rem;
    line-height: 1.78;
    max-width: 900px;
    color: var(--text-primary);
    margin-bottom: 1.2rem;
  }

  .front-panel__fact {
    padding: 1rem 1.2rem;
    border-radius: var(--radius-md);
    background: rgba(44, 197, 179, 0.08);
    border-left: 3px solid var(--accent-turquoise);
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  /* Philology Spotlight */
  .philology-box {
    margin-bottom: 3rem;
    padding: 2rem 2.1rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, rgba(24, 21, 38, 0.9), rgba(14, 18, 28, 0.94));
    border: 1px solid rgba(167, 139, 250, 0.34);
    box-shadow: var(--shadow-deep);
  }

  .philology-box__head h3 {
    font-size: clamp(1.6rem, 2.5vw, 2.05rem);
    margin: 0.8rem 0 1.35rem;
  }

  .philology-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    margin-bottom: 1.25rem;
  }

  .philology-col {
    padding: 1.2rem 1.3rem;
    border-radius: var(--radius-md);
    background: rgba(8, 9, 13, 0.62);
    border: 1px solid var(--border-subtle);
  }

  .philology-col--east {
    border-left: 3px solid var(--accent-gold);
  }

  .philology-col--west {
    border-left: 3px solid var(--accent-crimson);
  }

  .philology-col__tag {
    display: block;
    font-size: 0.69rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent-gold);
    margin-bottom: 0.3rem;
  }

  .philology-col__tag--west {
    color: var(--accent-crimson);
  }

  .philology-col strong {
    display: block;
    font-size: 0.86rem;
    color: var(--text-primary);
    margin-bottom: 0.45rem;
  }

  .philology-col p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.62;
    color: var(--text-secondary);
  }

  .philology-resolution {
    padding: 1.05rem 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(44, 197, 179, 0.09);
    border-left: 3px solid var(--accent-turquoise);
    font-size: 0.93rem;
    line-height: 1.72;
    color: var(--text-primary);
  }

  /* Balance Matrix */
  .balance-wrap {
    margin-bottom: 3rem;
  }

  .balance-wrap__head {
    max-width: 820px;
    margin-bottom: 1.8rem;
  }

  .balance-wrap__head h3 {
    font-size: 2.1rem;
    margin: 0.75rem 0 0.6rem;
  }

  .balance-table {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .balance-row {
    display: grid;
    grid-template-columns: 0.85fr 1.1fr 1.1fr;
    gap: 1rem;
    padding: 1.35rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
  }

  .balance-dim {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: 0.5rem;
  }

  .balance-dim span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .balance-dim h4 {
    font-size: 1.4rem;
  }

  .balance-cell {
    padding: 1.15rem 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(8, 9, 13, 0.55);
    border: 1px solid var(--border-subtle);
  }

  .balance-cell--west {
    border-left: 3px solid var(--accent-crimson);
  }

  .balance-cell--east {
    border-left: 3px solid var(--accent-turquoise);
  }

  .balance-verdict {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    color: #ff8196;
    margin-bottom: 0.18rem;
  }

  .balance-verdict--east {
    color: var(--accent-turquoise);
  }

  .balance-side {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 0.55rem;
  }

  .balance-cell p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.62;
    color: var(--text-primary);
  }

  /* Sources Drawer */
  .sources-drawer {
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 1.35rem 1.75rem;
  }

  .sources-drawer summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
  }

  .sources-drawer summary::-webkit-details-marker {
    display: none;
  }

  .sources-drawer summary div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .sources-drawer__chevron {
    font-size: 1.25rem;
    color: var(--accent-gold);
    transition: transform 0.25s ease;
  }

  .sources-drawer[open] .sources-drawer__chevron {
    transform: rotate(180deg);
  }

  .sources-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .source-item {
    padding: 1.1rem;
    border-radius: var(--radius-md);
    background: rgba(8, 9, 13, 0.55);
    border: 1px solid var(--border-subtle);
  }

  .source-item h4 {
    font-size: 1.2rem;
    margin-bottom: 0.2rem;
  }

  .source-side {
    display: block;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
  }

  .source-item p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .modern-refs {
    margin: 1.35rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  @media (max-width: 960px) {
    .balance-row,
    .philology-cols,
    .sources-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
