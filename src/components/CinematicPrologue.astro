---
import { sceneHeroVisuals, type VisualAsset } from '../data/antakya1098';

interface Props {
  badges?: { text: string; variant: 'east' | 'west' | 'turquoise' }[];
  titleMain?: string;
  titleAccent?: string;
  leadHtml?: string;
  visual?: VisualAsset;
  chronometer?: { year: string; desc: string; active?: boolean }[];
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  badges = [
    { text: 'DOSYA 01 · ETKİLEŞİMLİ BELGESEL', variant: 'east' },
    { text: '8 BİRİNCİL VEKÂYİNÂME ÇAPRAZ OKUMASI', variant: 'west' },
    { text: 'DÖNEM EL YAZMASI & GRAVÜR ARŞİVİ', variant: 'turquoise' },
  ],
  titleMain = 'Kuşatanların Kuşatıldığı Gün:',
  titleAccent = 'Antakya 1098, Kürboğa ve Haçlı Seferlerinin Perde Arkası',
  leadHtml =
    'Haziran 1098’de Adana-Hatay koridorunun kilit taşı Antakya surları önünde tarihin akışı kırıldı. Açlıktan savaş atlarını kesip yiyen bir Haçlı ordusu, Musul Atabeyi Kıvâmüddevle Kürboğa’nın devasa koalisyonunu nasıl yendi? Bir cephenin <em>"dağdan beyaz atlı azizler indi"</em> diye yazdığı sabahı, karşı cephenin kayıtları <em>"tek bir kılıç bile vurulmadan emîrler çekildi"</em> diyerek nasıl otopsi etti?',
  visual = sceneHeroVisuals.prologue,
  chronometer = [
    { year: '638', desc: 'Kudüs Müslüman idaresine geçti (460 yıl sefer çıkmadı)' },
    { year: '1071 – 1084', desc: 'Malazgirt, Kudüs, İznik ve Antakya şoku' },
    { year: 'Kasım 1095', desc: 'Clermont Konsili: Çifte ajanda ateşlendi' },
    { year: '28 Haziran 1098', desc: 'Antakya Köprü Kapısı: Kader sabahı', active: true },
  ],
  ctaHref = '#sahne-harita',
  ctaLabel = 'Sahnelere İlerlemek İçin Kaydırın',
} = Astro.props;
---

<section id="prolog" class="prologue prologue--visual">
  <div class="prologue__backdrop" aria-hidden="true">
    <img
      src={visual.src}
      alt=""
      class:list={['prologue__backdrop-img', { 'is-engraving': visual.isEngraving }]}
      style={`object-position: ${visual.objectPosition || 'center'}`}
    />
    <div class="prologue__backdrop-mask" />
  </div>

  <div class="prologue__glow prologue__glow--gold" aria-hidden="true"></div>
  <div class="prologue__glow prologue__glow--crimson" aria-hidden="true"></div>

  <div class="container prologue__inner">
    <div class="prologue__badges reveal">
      {badges.map((b) => <span class={`pill pill--${b.variant}`}>{b.text}</span>)}
    </div>

    <h1 class="prologue__title reveal" style="--delay: 90ms">
      {titleMain}
      <span>{titleAccent}</span>
    </h1>

    <p class="prologue__lead reveal" style="--delay: 180ms" set:html={leadHtml} />

    {
      visual && (
        <figure class="prologue__showcase reveal" style="--delay: 220ms">
          <div class="prologue__showcase-frame">
            <img
              src={visual.src}
              alt={visual.caption}
              class:list={['prologue__showcase-img', { 'is-engraving': visual.isEngraving }]}
              style={`object-position: ${visual.objectPosition || 'center'}`}
              loading="eager"
            />
            <span class="prologue__showcase-badge">{visual.badge}</span>
          </div>
          <figcaption class="prologue__showcase-cap">
            <strong>{visual.caption}</strong>
            <span>{visual.credit}</span>
          </figcaption>
        </figure>
      )
    }

    <div class="prologue__chronometer reveal" style="--delay: 260ms" aria-label="Tarihsel Eşik Çizgisi">
      {
        chronometer.map((node) => (
          <div class:list={['chrono-node', { 'chrono-node--active': node.active }]}>
            <span class="chrono-year">{node.year}</span>
            <span class="chrono-desc">{node.desc}</span>
          </div>
        ))
      }
    </div>

    <div class="prologue__cta reveal" style="--delay: 340ms">
      <a href={ctaHref} class="scroll-cue">
        <span>{ctaLabel}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .prologue {
    position: relative;
    min-height: calc(100vh - 68px);
    display: flex;
    align-items: center;
    padding: 4rem 0 4.5rem;
    overflow: hidden;
  }

  .prologue__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .prologue__backdrop-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.34;
    filter: saturate(0.85) contrast(1.08);
    transform: scale(1.03);
  }

  .prologue__backdrop-img.is-engraving {
    opacity: 0.24;
    filter: sepia(0.55) contrast(1.18) brightness(0.55);
  }

  .prologue__backdrop-mask {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 9, 13, 0.94) 0%, rgba(8, 9, 13, 0.78) 55%, rgba(8, 9, 13, 0.62) 100%),
      linear-gradient(180deg, rgba(8, 9, 13, 0.72) 0%, rgba(8, 9, 13, 0.35) 45%, rgba(8, 9, 13, 0.96) 100%);
  }

  .prologue__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
    z-index: 0;
  }

  .prologue__glow--gold {
    width: 520px;
    height: 520px;
    top: -120px;
    left: -100px;
    background: rgba(217, 155, 78, 0.14);
  }

  .prologue__glow--crimson {
    width: 480px;
    height: 480px;
    bottom: -140px;
    right: -80px;
    background: rgba(217, 72, 95, 0.13);
  }

  .prologue__inner {
    position: relative;
    z-index: 1;
    max-width: 1020px;
  }

  .prologue__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }

  .prologue__title {
    font-size: clamp(2.4rem, 5.1vw, 4.35rem);
    line-height: 1.08;
    margin-bottom: 1.35rem;
  }

  .prologue__title span {
    display: block;
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.5rem, 2.9vw, 2.45rem);
    color: var(--accent-gold);
    margin-top: 0.55rem;
  }

  .prologue__lead {
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    max-width: 850px;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .prologue__lead :global(em) {
    color: var(--text-primary);
    font-style: italic;
  }

  .prologue__showcase {
    margin: 0 0 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgba(12, 15, 22, 0.88);
    border: 1px solid var(--border-gold);
    box-shadow: var(--shadow-deep);
  }

  .prologue__showcase-frame {
    position: relative;
    height: clamp(230px, 34vw, 370px);
    overflow: hidden;
    background: #090b10;
  }

  .prologue__showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .prologue__showcase-img.is-engraving {
    filter: sepia(0.28) contrast(1.08) brightness(0.9);
  }

  .prologue__showcase-badge {
    position: absolute;
    top: 0.9rem;
    left: 0.95rem;
    padding: 0.32rem 0.72rem;
    border-radius: 999px;
    background: rgba(8, 10, 15, 0.86);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-gold);
    color: var(--accent-gold);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .prologue__showcase-cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.25rem;
    padding: 0.82rem 1.15rem;
    background: rgba(14, 18, 27, 0.95);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
  }

  .prologue__showcase-cap strong {
    color: var(--text-primary);
  }

  .prologue__showcase-cap span {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .prologue__chronometer {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    padding: 1.35rem;
    border-radius: var(--radius-lg);
    background: rgba(18, 22, 32, 0.78);
    border: 1px solid var(--border-subtle);
    margin-bottom: 2.2rem;
  }

  .chrono-node {
    padding: 0.65rem 0.8rem;
    border-left: 2px solid rgba(243, 237, 226, 0.16);
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  .chrono-node--active {
    border-left-color: var(--accent-crimson);
    background: linear-gradient(90deg, rgba(217, 72, 95, 0.12), transparent);
    border-radius: 0 10px 10px 0;
  }

  .chrono-year {
    font-family: var(--font-serif);
    font-size: 1.32rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .chrono-node--active .chrono-year {
    color: #ff7a8f;
  }

  .chrono-desc {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.8rem 1.35rem;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-primary);
    background: rgba(217, 155, 78, 0.14);
    border: 1px solid var(--border-gold);
    transition: all 0.25s ease;
  }

  .scroll-cue:hover {
    background: rgba(217, 155, 78, 0.26);
    transform: translateY(2px);
  }

  .scroll-cue svg {
    animation: bob 2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (max-width: 820px) {
    .prologue__chronometer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .prologue__chronometer {
      grid-template-columns: 1fr;
    }
  }
</style>
