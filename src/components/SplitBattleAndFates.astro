---
import { actorFates as defaultActors, sceneHeroVisuals, type ActorFate } from '../data/antakya1098';
import type { ChronicleStage } from '../data/hittin1187';

interface Props {
  battleHeader?: {
    eyebrow: string;
    title: string;
    leadHtml: string;
    toggleBtnLabel?: string;
  };
  chronicleStages?: ChronicleStage[];
  fatesHeader?: {
    eyebrow: string;
    title: string;
    leadHtml: string;
    frontLabel?: string;
    backLabel?: string;
    flipBackText?: string;
  };
  actors?: ActorFate[];
}

const defaultStage: ChronicleStage = {
  id: 'stage-antioch-1098',
  bannerVisual: sceneHeroVisuals.battleBridgeGate,
  east: {
    pill: 'İSLAM CEPHESİ KAYDI',
    date: 'Hicrî 491 / Haziran 1098 · c. X, s. 189–190 (Dâr Sâdır s. 276)',
    titleHtml: 'İbnü’l-Esîr · <em>el-Kâmil fi’t-Târîh</em>',
    authorDesc:
      'Musul-Cezîre tarihçisi; erken dönem Halep ve Musul askeri kayıtlarına dayanır (Arapça aslından doğrudan çeviri; 491 h. kaydı, nşr. C. J. Tornberg, Leiden 1864, c. X, s. 189–190; Beyrut: Dâr Sâdır 1966, c. X, s. 276).',
    origLang: 'ar',
    origScript:
      '«[...] فخرجوا في اليوم الخامس من الباب متفرقين من خمسة وستة ونحو ذلك؛ فقال المسلمون لكربوقا: ينبغي أن تقف على الباب فتقتل كل من يخرج فإن أمرهم الآن وهم متفرقون سهل. فقال: لا تفعلوا! أمهلوهم حتى يتكامل خروجهم فنقتلهم [...] فقتل قوم من المسلمين جماعة من الخارجين، فجاء إليهم بنفسه ومنعهم. فلمّا تكامل خروج الفرنج [...] ولّى المسلمون منهزمين [...] ولم يضرب أحد منهم بسيف، ولا طعن برمح، ولا رمى بسهم [...]»',
    translationParagraphsHtml: [
      '«[...] Beşinci gün [Franklar] kapıdan beşer altışar ve benzeri dağınık gruplar halinde çıktılar. Müslümanlar Kürboğa’ya: <mark class="hl-east">"Kapının önünde durup çıkan herkesi öldürmen gerekir; zira şu an dağınık haldeyken onların işi kolaydır"</mark> dediler. O ise: <em>"Yapmayın! Bırakın hepsinin dışarı çıkışı tamamlansın ki onları [hep birlikte] öldürelim"</em> dedi. [...] Müslümanlardan bir topluluk dışarı çıkanlardan bir grubu öldürdü; fakat <mark class="hl-east">[Kürboğa] bizzat yanlarına gelerek onları engelledi.</mark>»',
      '«Frankların çıkışı tamamlanıp [büyük bir saf kurduklarında] Müslümanlar; [Kürboğa’nın] evvela kendilerini küçümsemesi, ikinci olarak da [Frankları] öldürmelerine engel olması yüzünden bozgun halinde arkalarını dönüp çekildiler [...] <mark class="hl-east">içlerinden hiç kimse ne bir kılıç vurdu, ne bir mızrak sapladı, ne de bir ok attı.</mark> [Pusuda oldukları için en son çekilenler Sökmen bin Artuk ile Cenâhüddevle oldu; Franklar ise hiçbir çarpışma olmadan gerçekleşen bu çekilmeyi hile ve tuzak sanıp takip etmekten korktular.]»',
    ],
  },
  west: {
    pill: 'HAÇLI CEPHESİ GÖRGÜ TANIĞI',
    date: 'Kitap IX, Bölüm 29 · Haziran 1098 (nşr. R. Hill, s. 68–70 [69])',
    titleHtml: 'Anonim Şövalye · <em>Gesta Francorum</em>',
    authorDesc:
      'Bohemund’un birliğinde Köprü Kapısı’ndan bizzat çıkan Frank savaşçının günlüğü (Latince aslından doğrudan çeviri; IX.29, nşr. Rosalind Hill, London 1962, s. 68–70 [alıntı: s. 69]; krş. nşr. H. Hagenmeyer, Heidelberg 1890, cap. XXIX, §§5–6, s. 374–376).',
    origLang: 'la',
    origScript:
      '«[...] Exibant quoque de montaneis innumerabiles exercitus, habentes equos albos, quorum uexilla omnia erant alba [...] cognouerunt esse adiutorium Christi, cuius ductores fuerunt sancti Georgius, Mercurius et Demetrius [...] Turci autem, qui stabant in parte maris, uidentes quod non possent sufferre amplius, miserunt ignem in herbam, ut uidentes illi qui erant in tentoriis fugerent.»',
    translationParagraphsHtml: [
      '«[...] <mark class="hl-west">Dağlardan da atları beyaz ve sancaklarının tamamı beyaz olan sayısız ordular çıktı.</mark> [Bizimkiler bu orduyu görünce ne olduğunu hiç anlayamadılar; ta ki] bunların <mark class="hl-west">önderleri Aziz Georgios, Mercurius ve Demetrius olan Mesih’in yardımı</mark> olduğunu kavrayana dek. [Buna inanılmalıdır, zira adamlarımızdan pek çoğu bunu bizzat gördü.]»',
      '«Deniz tarafında bulunan Türkler ise artık hiçbir şekilde tutunamayacaklarını görünce, çadırlarda bulunanlar bunu görüp kaçsınlar diye <mark class="hl-west">otları ateşe verdiler [...]</mark>» <em>(Kaynak Notu: Kuru otların yakılması hem duman perdesi hem de karargâhtakiler için geri çekilme işaretiydi.)</em>',
    ],
  },
  synthesisBridge: {
    title: 'Çapraz Okuma Sentezi: Aynı Olayın İki Yüzü',
    bodyHtml:
      'Kürboğa’nın İçkale’ye kendi adamı <strong>Ahmed bin Mervân</strong>’ı atayarak Antakya’yı sahipleneceğini göstermesi üzerine <strong>Şam Meliki Dukak</strong> ve müttefik emîrler muharebe anında ordularını çekti. Günlerdir açlık sınırında yaşayan Haçlı askerleri ise koca koalisyonun neredeyse çarpışmadan bir anda eriyip dağılmasını, dağlardan inen beyaz atlı azizlerin ilahî müdahalesi olarak algılayıp kaydetti.',
  },
};

const {
  battleHeader = {
    eyebrow: 'SAHNE 04 · İKİ CEPHE, TEK SABAH (28 HAZİRAN 1098)',
    title: 'Köprü Kapısı’nda Ne Oldu? Yan Yana İki Kayıt',
    leadHtml:
      'Aynı savaş sabahına ait iki birincil metni yan yana okuduğunuzda tarihin en sarsıcı yapbozlarından biri tamamlanır: Bir tarafın <strong>"mucize"</strong> gördüğü yerde, diğer taraf <strong>"siyasi boykot ve taktik iflası"</strong> kaydetmiştir.',
    toggleBtnLabel: 'Arapça ve Latince Orijinal Metin Satırlarını Göster / Gizle',
  },
  chronicleStages = [defaultStage],
  fatesHeader = {
    eyebrow: 'SAHNE 05 · TARİHİN İRONİSİ VE AKIBETLER',
    title: 'Meydandan Çekilen Aktörlere Sonra Ne Oldu?',
    leadHtml:
      '<em>"Kürboğa güçlenmesin, elimizdeki şehirleri almasın"</em> hesabı yaparak koalisyonu sabote edenlerin tamamı, kaçındıkları felaketin çok daha ağırını bizzat Haçlıların ve birbirlerinin elinden yaşadı. Kartlara tıklayarak <strong>1098’deki hesaplarını</strong> ve <strong>tarihin kestiği faturayı</strong> karşılaştırın.',
    frontLabel: '28 HAZİRAN 1098’DEKİ HESABI',
    backLabel: 'SONRASINDA YAŞADIĞI AKIBET',
    flipBackText: '← 1098’deki Hesabına Dön',
  },
  actors = defaultActors,
} = Astro.props;
---

<!-- SAHNE 04: BÖLÜNMÜŞ VEKÂYİNÂME SAHNESİ -->
<section id="sahne-kopru-kapisi" class="section-shell split-battle-section">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">{battleHeader.eyebrow}</span>
      <h2 class="section-title">{battleHeader.title}</h2>
      <p class="section-lead" set:html={battleHeader.leadHtml} />

      <button
        type="button"
        class="orig-toggle-btn"
        id="toggle-original-scripts"
        data-toggle-originals="header"
        data-default-label={battleHeader.toggleBtnLabel || 'Arapça ve Latince Orijinal Metin Satırlarını Göster / Gizle'}
        aria-pressed="false"
      >
        <span class="orig-toggle-btn__icon" aria-hidden="true">📜</span>
        <span data-orig-btn-text>
          {battleHeader.toggleBtnLabel || 'Arapça ve Latince Orijinal Metin Satırlarını Göster / Gizle'}
        </span>
      </button>
    </div>

    <div class="chronicle-stages-list">
      {
        chronicleStages.map((stage, stageIdx) => (
          <div class:list={['chronicle-stage-block', { 'chronicle-stage-block--subsequent': stageIdx > 0 }]}>
            {stage.stageTitle && (
              <div class="substage-header reveal">
                {stage.stageBadge && <span class="pill pill--east">{stage.stageBadge}</span>}
                <h3>{stage.stageTitle}</h3>
                {stage.stageLead && <p>{stage.stageLead}</p>}
              </div>
            )}

            {stage.bannerVisual && (
              <figure class="battle-banner reveal">
                <div class="battle-banner__frame">
                  <img
                    src={stage.bannerVisual.src}
                    alt={stage.bannerVisual.caption}
                    class:list={['battle-banner__img', { 'is-engraving': stage.bannerVisual.isEngraving }]}
                    style={`object-position: ${stage.bannerVisual.objectPosition || 'center'}`}
                    loading="lazy"
                  />
                  <span class="battle-banner__badge">{stage.bannerVisual.badge}</span>
                </div>
                <figcaption class="battle-banner__cap">
                  <strong>{stage.bannerVisual.caption}</strong>
                  <span>{stage.bannerVisual.credit}</span>
                </figcaption>
              </figure>
            )}

            <div class="stage-orig-toolbar reveal">
              <span class="stage-orig-toolbar__hint">Karşılaştırmalı Birincil Metin Sütunları</span>
              <button
                type="button"
                class="orig-toggle-btn orig-toggle-btn--inline"
                data-toggle-originals="inline"
                data-default-label={
                  battleHeader.toggleBtnLabel || 'Arapça ve Latince Orijinal Metin Satırlarını Göster / Gizle'
                }
                aria-pressed="false"
              >
                <span class="orig-toggle-btn__icon" aria-hidden="true">📜</span>
                <span data-orig-btn-text>
                  {battleHeader.toggleBtnLabel || 'Arapça ve Latince Orijinal Metin Satırlarını Göster / Gizle'}
                </span>
              </button>
            </div>

            <div class="split-chronicles" data-chronicle-stage id={stageIdx === 0 ? 'chronicle-stage' : stage.id}>
              <!-- SOL SÜTUN -->
              <article class="chronicle-col chronicle-col--east reveal">
                <div class="chronicle-col__head">
                  <span class="pill pill--east">{stage.east.pill}</span>
                  <span class="chronicle-date">{stage.east.date}</span>
                </div>

                <h3 set:html={stage.east.titleHtml} />
                <p class="chronicle-author">{stage.east.authorDesc}</p>

                <div
                  class:list={[
                    'orig-script',
                    stage.east.origLang === 'ar' || stage.east.origLang === 'fa'
                      ? 'orig-script--arabic'
                      : stage.east.origLang === 'el'
                        ? 'orig-script--greek'
                        : 'orig-script--latin',
                  ]}
                  lang={stage.east.origLang}
                  dir={stage.east.origLang === 'ar' || stage.east.origLang === 'fa' ? 'rtl' : 'ltr'}
                >
                  {stage.east.origScript}
                </div>

                <div class="chronicle-translation">
                  {stage.east.translationParagraphsHtml.map((pHtml) => (
                    <p set:html={pHtml} />
                  ))}
                </div>
              </article>

              <!-- SAĞ SÜTUN -->
              <article class="chronicle-col chronicle-col--west reveal" style="--delay: 120ms">
                <div class="chronicle-col__head">
                  <span class="pill pill--west">{stage.west.pill}</span>
                  <span class="chronicle-date">{stage.west.date}</span>
                </div>

                <h3 set:html={stage.west.titleHtml} />
                <p class="chronicle-author">{stage.west.authorDesc}</p>

                <div
                  class:list={[
                    'orig-script',
                    stage.west.origLang === 'el' ? 'orig-script--greek' : 'orig-script--latin',
                  ]}
                  lang={stage.west.origLang}
                >
                  {stage.west.origScript}
                </div>

                <div class="chronicle-translation">
                  {stage.west.translationParagraphsHtml.map((pHtml) => (
                    <p set:html={pHtml} />
                  ))}
                </div>
              </article>
            </div>

            {stage.ransomTariffBox && (
              <div class="tariff-box reveal">
                <div class="tariff-box__head">
                  <span class="pill pill--turquoise">{stage.ransomTariffBox.badge}</span>
                  <h4>{stage.ransomTariffBox.title}</h4>
                  <p>{stage.ransomTariffBox.lead}</p>
                </div>
                <div class="tariff-grid">
                  {stage.ransomTariffBox.items.map((item) => (
                    <div class="tariff-card">
                      <span class="tariff-card__label">{item.label}</span>
                      <strong class="tariff-card__val">{item.value}</strong>
                      <small class="tariff-card__note">{item.note}</small>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- SENTEZ KÖPRÜSÜ -->
            <div class="synthesis-bridge reveal">
              <div class="synthesis-bridge__icon" aria-hidden="true">⇄</div>
              <div>
                <h4>{stage.synthesisBridge.title}</h4>
                <p set:html={stage.synthesisBridge.bodyHtml} />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- SAHNE 05: AKTÖR KADER KARTLARI -->
<section
  id="sahne-ihanet"
  class="section-shell"
  data-flip-back-label={fatesHeader.flipBackText || '← 1098’deki Hesabına Dön'}
>
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">{fatesHeader.eyebrow}</span>
      <h2 class="section-title">{fatesHeader.title}</h2>
      <p class="section-lead" set:html={fatesHeader.leadHtml} />
    </div>

    <div class="fates-grid">
      {
        actors.map((actor, idx) => (
          <article
            id={`fate-card-${idx}`}
            class:list={['fate-card', 'reveal', `fate-card--${actor.stance}`]}
            style={`--delay: ${idx * 65}ms`}
            data-fate-card
            data-fate-index={idx}
            data-flipped="false"
            tabindex="0"
            role="button"
            aria-label={`${actor.name} kartını çevir`}
          >
            <div class="fate-card__head">
              <span class:list={['pill', actor.stance === 'loyal' ? 'pill--turquoise' : 'pill--west']}>
                {actor.badgeText ||
                  (actor.stance === 'loyal' ? 'SON ANA KADAR DİRENEN' : 'SABOTAJ / ÇEKİLME AKTÖRÜ')}
              </span>
              <span class="fate-card__end">{actor.endDate}</span>
            </div>

            <h3 class="fate-card__name">{actor.name}</h3>
            <p class="fate-card__role">{actor.role}</p>

            <div class="fate-card__body">
              <div class="fate-face fate-face--calc">
                <span class="fate-face__label">{fatesHeader.frontLabel || '28 HAZİRAN 1098’DEKİ HESABI'}</span>
                <p>{actor.calculation1098}</p>
              </div>

              <div class="fate-face fate-face--payback">
                <span class="fate-face__label fate-face__label--after">
                  {fatesHeader.backLabel || 'SONRASINDA YAŞADIĞI AKIBET'}
                </span>
                <p>{actor.historicalPayback}</p>
              </div>
            </div>

            <div class="fate-card__footer">
              <span data-fate-cta>Akıbetini Görmek İçin Tıklayın ↻</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { onPageReady } from '../utils/onPageReady';

  function initSplitAndFates() {
    const toggleBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-toggle-originals]'));
    const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-chronicle-stage]'));

    const syncButtons = (isOpen: boolean) => {
      toggleBtns.forEach((btn) => {
        const defaultLabel =
          btn.dataset.defaultLabel || 'Orijinal Metin Satırlarını Göster / Gizle';
        btn.classList.toggle('is-active', isOpen);
        btn.setAttribute('aria-pressed', String(isOpen));
        const iconEl = btn.querySelector<HTMLElement>('.orig-toggle-btn__icon');
        if (iconEl) {
          iconEl.textContent = isOpen ? '✓' : '📜';
        }
        const textEl = btn.querySelector<HTMLElement>('[data-orig-btn-text]');
        if (textEl) {
          textEl.textContent = isOpen
            ? 'Orijinal Metin Satırları Açık — Gizlemek İçin Tıklayın'
            : defaultLabel;
        }
      });
    };

    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const nextOpen = !stages[0]?.classList.contains('show-originals');
        stages.forEach((st) => st.classList.toggle('show-originals', nextOpen));
        syncButtons(nextOpen);

        if (nextOpen && btn.dataset.toggleOriginals === 'header') {
          const firstOrig = stages[0]?.querySelector<HTMLElement>('.orig-script');
          if (firstOrig) {
            const rect = firstOrig.getBoundingClientRect();
            if (rect.top > window.innerHeight - 130 || rect.bottom < 80) {
              stages[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        }
      });
    });

    const fatesSec = document.getElementById('sahne-ihanet');
    const flipBackLabel = fatesSec?.dataset.flipBackLabel || '← Önceki Yüze Dön';

    const fateCards = Array.from(document.querySelectorAll<HTMLElement>('[data-fate-card]'));
    const toggleFate = (card: HTMLElement) => {
      const next = card.dataset.flipped !== 'true';
      card.dataset.flipped = String(next);
      const cta = card.querySelector('[data-fate-cta]');
      if (cta) {
        cta.textContent = next ? flipBackLabel : 'Akıbetini Görmek İçin Tıklayın ↻';
      }
    };

    fateCards.forEach((card) => {
      card.addEventListener('click', () => toggleFate(card));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleFate(card);
        }
      });
    });
  }

  onPageReady(initSplitAndFates);
</script>

<style>
  .chronicle-stage-block--subsequent {
    margin-top: 4.2rem;
    padding-top: 3.4rem;
    border-top: 1px solid var(--border-subtle);
  }

  .substage-header {
    max-width: 820px;
    margin-bottom: 1.75rem;
  }

  .substage-header h3 {
    font-size: clamp(1.75rem, 2.8vw, 2.3rem);
    margin: 0.7rem 0 0.5rem;
  }

  .substage-header p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .battle-banner {
    margin: 0 0 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border-crimson);
    box-shadow: var(--shadow-deep);
  }

  .battle-banner__frame {
    position: relative;
    height: clamp(240px, 36vw, 410px);
    overflow: hidden;
    background: #090b10;
  }

  .battle-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .battle-banner__img.is-engraving {
    filter: sepia(0.28) contrast(1.08) brightness(0.88);
  }

  .battle-banner__badge {
    position: absolute;
    top: 0.9rem;
    left: 0.95rem;
    padding: 0.3rem 0.72rem;
    border-radius: 999px;
    background: rgba(8, 10, 15, 0.86);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-crimson);
    color: #ff8a9e;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .battle-banner__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.2rem;
    padding: 0.82rem 1.2rem;
    background: rgba(14, 18, 27, 0.96);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
  }

  .battle-banner__cap strong {
    color: var(--text-primary);
  }

  .battle-banner__cap span {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .orig-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.2rem;
    padding: 0.68rem 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--border-gold);
    background: var(--accent-gold-soft);
    color: var(--accent-gold);
    font-family: var(--font-sans);
    font-size: 0.83rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.22s ease;
  }

  .orig-toggle-btn:hover {
    background: rgba(217, 155, 78, 0.24);
    transform: translateY(-1px);
  }

  .orig-toggle-btn.is-active {
    background: var(--accent-gold);
    border-color: var(--accent-gold);
    color: #090a0e;
    box-shadow: 0 8px 22px rgba(217, 155, 78, 0.32);
  }

  .orig-toggle-btn__icon {
    font-size: 0.9rem;
    line-height: 1;
  }

  .stage-orig-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem 1rem;
    margin-bottom: 0.95rem;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-md);
    background: rgba(14, 18, 27, 0.72);
    border: 1px solid var(--border-subtle);
  }

  .stage-orig-toolbar__hint {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .orig-toggle-btn--inline {
    margin-top: 0;
    padding: 0.44rem 0.92rem;
    font-size: 0.76rem;
  }

  .split-chronicles {
    scroll-margin-top: 5.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem;
    margin-bottom: 1.8rem;
  }

  .chronicle-col {
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-deep);
  }

  .chronicle-col--east {
    border-top: 3px solid var(--accent-gold);
  }

