---
import { actorFates as defaultActors, sceneHeroVisuals, type ActorFate } from '../data/antakya1098';
import type { ChronicleStage } from '../data/hittin1187';

interface Props {
  battleHeader?: {
    eyebrow: string;
    title: string;
    leadHtml: string;
    toggleBtnLabel?: string;
  };
  chronicleStages?: ChronicleStage[];
  fatesHeader?: {
    eyebrow: string;
    title: string;
    leadHtml: string;
    frontLabel?: string;
    backLabel?: string;
    flipBackText?: string;
  };
  actors?: ActorFate[];
}

const defaultStage: ChronicleStage = {
  id: 'stage-antioch-1098',
  bannerVisual: sceneHeroVisuals.battleBridgeGate,
  east: {
    pill: 'İSLAM CEPHESİ KAYDI',
    date: 'Hicrî 491 / Haziran 1098',
    titleHtml: 'İbnü’l-Esîr · <em>el-Kâmil fi’t-Târîh</em>',
    authorDesc: 'Musul-Cezîre tarihçisi; erken dönem Halep ve Musul askeri kayıtlarına dayanır.',
    origLang: 'ar',
    origScript:
      '«...فخرجوا في اليوم الخامس من الباب من خمسة وستة ونحو ذلك؛ فقال المسلمون لكربوقا: ينبغي أن نقف على الباب فنقتل كل من يخرج فإن أمرهم الآن سهل. فقال: أمهلوهم حتى يتكاملوا... فقتل قوم من المسلمين جماعة من الخارجين، فجاء إليهم بنفسه ومنعهم. فلمّا تكامل خروج الفرنج... ولّى المسلمون منهزمين... ولم يضرب أحد منهم بسيف، ولا طعن برمح، ولا رمى بسهم...»',
    translationParagraphsHtml: [
      '«Franklar kapıdan beşer altışar kişilik gruplar halinde çıkmaya başladılar. Müslüman komutanlar Kürboğa’ya: <mark class="hl-east">"Kapının önünde duralım ve çıkan herkesi tek tek öldürelim; şu an onların işini bitirmek çok kolaydır"</mark> dediler. Kürboğa ise: <em>"Bırakın hepsi dışarı çıkıp tamamlansın"</em> dedi. Hatta Müslümanlardan bir grup ileri atılıp dışarı çıkanlardan bazılarını öldürdü; fakat <mark class="hl-east">Kürboğa bizzat yanlarına at sürerek kendi askerlerini engelledi.</mark>»',
      '«Frankların çıkışı tamamlanıp büyük bir savaş safı kurduklarında Müslümanlar; Kürboğa’nın evvela kendilerini küçümsemesi, ikinci olarak da Frankları kapıda öldürmelerine engel olması yüzünden arkalarını dönüp kaçtılar. Öyle ki <mark class="hl-east">hiç kimse ne bir kılıç vurdu, ne bir mızrak sapladı, ne de bir ok attı.</mark> En son çekilenler pusuda bekledikleri için Sökmen bin Artuk ile Cenâhüddevle oldu. Franklar bu manzarayı gördüklerinde, böylesi bir bozgunu gerektirecek hiçbir çarpışma yaşanmadığından <strong>bunun bir tuzak olduğunu zannettiler ve takip etmekten korktular...</strong>»',
    ],
  },
  west: {
    pill: 'HAÇLI CEPHESİ GÖRGÜ TANIĞI',
    date: 'Kitap IX, Bölüm 29 · Haziran 1098',
    titleHtml: 'Anonim Şövalye · <em>Gesta Francorum</em>',
    authorDesc: 'Bohemund’un birliğinde Köprü Kapısı’ndan bizzat çıkan Frank savaşçının günlüğü.',
    origLang: 'la',
    origScript:
      '«...Exierunt quoque de montibus innumerabiles exercitus, habentes equos albos, quorum uexilla omnia erant alba... cognouerunt esse adiutorium Christi, cuius ductores fuerunt sanctus Georgius, Mercurius et Demetrius... Turci igitur qui erant ex parte maris, uidentes se nullatenus posse subsistere, miserunt ignem in herbam, ut uidentes illi qui erant in tentoriis fugerent...»',
    translationParagraphsHtml: [
      '«Sancakları taşıyan Bohemund ile diğer komutanlarımız nehrin üzerindeki köprüden geçerek ilerlediler... Deniz tarafında mevzilenmiş olan Türkler artık tutunamayacaklarını anlayınca, çadırlarda bulunanlar görüp kaçsın diye <mark class="hl-west">yerdeki kuru otları ateşe verdiler</mark> (hem duman perdesi hem çekilme işareti).»',
      '«Tam bu sırada <mark class="hl-west">dağlardan, atları da sancakları da bembeyaz olan sayısız ordular çıktı.</mark> Liderlerimiz bu orduyu gördüklerinde bunun ne olduğunu ve kim olduklarını hiç anlayamadılar; ta ki bunların <mark class="hl-west">Aziz Georgios, Mercurius ve Demetrius önderliğindeki Mesih’in yardımı</mark> olduğunu kavrayana dek. Buna inanılmalıdır, zira adamlarımızdan pek çoğu bunu gözleriyle gördü... Düşman Fırat’a doğru kaçarken altın, gümüş ve erzak dolu çadırlarını geride bıraktı.»',
    ],
  },
  synthesisBridge: {
    title: 'Çapraz Okuma Sentezi: Aynı Olayın İki Yüzü',
    bodyHtml:
      'Kürboğa’nın İçkale’ye kendi adamı <strong>Ahmed bin Mervân</strong>’ı atayarak Antakya’yı sahipleneceğini göstermesi üzerine <strong>Şam Meliki Dukak</strong> ve müttefik emîrler muharebe anında ordularını çekti. Günlerdir açlık sınırında yaşayan Haçlı askerleri ise koca koalisyonun neredeyse çarpışmadan bir anda eriyip dağılmasını, dağlardan inen beyaz atlı azizlerin ilahî müdahalesi olarak algılayıp kaydetti.',
  },
};

const {
  battleHeader = {
    eyebrow: 'SAHNE 04 · İKİ CEPHE, TEK SABAH (28 HAZİRAN 1098)',
    title: 'Köprü Kapısı’nda Ne Oldu? Yan Yana İki Kayıt',
    leadHtml:
      'Aynı savaş sabahına ait iki birincil metni yan yana okuduğunuzda tarihin en sarsıcı yapbozlarından biri tamamlanır: Bir tarafın <strong>"mucize"</strong> gördüğü yerde, diğer taraf <strong>"siyasi boykot ve taktik iflası"</strong> kaydetmiştir.',
    toggleBtnLabel: 'Arapça ve Latince Orijinal Metin Satırlarını Göster / Gizle',
  },
  chronicleStages = [defaultStage],
  fatesHeader = {
    eyebrow: 'SAHNE 05 · TARİHİN İRONİSİ VE AKIBETLER',
    title: 'Meydandan Çekilen Aktörlere Sonra Ne Oldu?',
    leadHtml:
      '<em>"Kürboğa güçlenmesin, elimizdeki şehirleri almasın"</em> hesabı yaparak koalisyonu sabote edenlerin tamamı, kaçındıkları felaketin çok daha ağırını bizzat Haçlıların ve birbirlerinin elinden yaşadı. Kartlara tıklayarak <strong>1098’deki hesaplarını</strong> ve <strong>tarihin kestiği faturayı</strong> karşılaştırın.',
    frontLabel: '28 HAZİRAN 1098’DEKİ HESABI',
    backLabel: 'SONRASINDA YAŞADIĞI AKIBET',
    flipBackText: '← 1098’deki Hesabına Dön',
  },
  actors = defaultActors,
} = Astro.props;
---

<!-- SAHNE 04: BÖLÜNMÜŞ VEKÂYİNÂME SAHNESİ -->
<section id="sahne-kopru-kapisi" class="section-shell split-battle-section">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">{battleHeader.eyebrow}</span>
      <h2 class="section-title">{battleHeader.title}</h2>
      <p class="section-lead" set:html={battleHeader.leadHtml} />

      <button type="button" class="orig-toggle-btn" id="toggle-original-scripts">
        {battleHeader.toggleBtnLabel || 'Arapça ve Latince Orijinal Metin Satırlarını Göster / Gizle'}
      </button>
    </div>

    <div class="chronicle-stages-list">
      {
        chronicleStages.map((stage, stageIdx) => (
          <div class:list={['chronicle-stage-block', { 'chronicle-stage-block--subsequent': stageIdx > 0 }]}>
            {stage.stageTitle && (
              <div class="substage-header reveal">
                {stage.stageBadge && <span class="pill pill--east">{stage.stageBadge}</span>}
                <h3>{stage.stageTitle}</h3>
                {stage.stageLead && <p>{stage.stageLead}</p>}
              </div>
            )}

            {stage.bannerVisual && (
              <figure class="battle-banner reveal">
                <div class="battle-banner__frame">
                  <img
                    src={stage.bannerVisual.src}
                    alt={stage.bannerVisual.caption}
                    class:list={['battle-banner__img', { 'is-engraving': stage.bannerVisual.isEngraving }]}
                    style={`object-position: ${stage.bannerVisual.objectPosition || 'center'}`}
                    loading="lazy"
                  />
                  <span class="battle-banner__badge">{stage.bannerVisual.badge}</span>
                </div>
                <figcaption class="battle-banner__cap">
                  <strong>{stage.bannerVisual.caption}</strong>
                  <span>{stage.bannerVisual.credit}</span>
                </figcaption>
              </figure>
            )}

            <div class="split-chronicles" data-chronicle-stage id={stageIdx === 0 ? 'chronicle-stage' : stage.id}>
              <!-- SOL SÜTUN -->
              <article class="chronicle-col chronicle-col--east reveal">
                <div class="chronicle-col__head">
                  <span class="pill pill--east">{stage.east.pill}</span>
                  <span class="chronicle-date">{stage.east.date}</span>
                </div>

                <h3 set:html={stage.east.titleHtml} />
                <p class="chronicle-author">{stage.east.authorDesc}</p>

                <div class="orig-script orig-script--arabic" lang={stage.east.origLang} dir="rtl">
                  {stage.east.origScript}
                </div>

                <div class="chronicle-translation">
                  {stage.east.translationParagraphsHtml.map((pHtml) => (
                    <p set:html={pHtml} />
                  ))}
                </div>
              </article>

              <!-- SAĞ SÜTUN -->
              <article class="chronicle-col chronicle-col--west reveal" style="--delay: 120ms">
                <div class="chronicle-col__head">
                  <span class="pill pill--west">{stage.west.pill}</span>
                  <span class="chronicle-date">{stage.west.date}</span>
                </div>

                <h3 set:html={stage.west.titleHtml} />
                <p class="chronicle-author">{stage.west.authorDesc}</p>

                <div
                  class:list={[
                    'orig-script',
                    stage.west.origLang === 'el' ? 'orig-script--greek' : 'orig-script--latin',
                  ]}
                  lang={stage.west.origLang}
                >
                  {stage.west.origScript}
                </div>

                <div class="chronicle-translation">
                  {stage.west.translationParagraphsHtml.map((pHtml) => (
                    <p set:html={pHtml} />
                  ))}
                </div>
              </article>
            </div>

            {stage.ransomTariffBox && (
              <div class="tariff-box reveal">
                <div class="tariff-box__head">
                  <span class="pill pill--turquoise">{stage.ransomTariffBox.badge}</span>
                  <h4>{stage.ransomTariffBox.title}</h4>
                  <p>{stage.ransomTariffBox.lead}</p>
                </div>
                <div class="tariff-grid">
                  {stage.ransomTariffBox.items.map((item) => (
                    <div class="tariff-card">
                      <span class="tariff-card__label">{item.label}</span>
                      <strong class="tariff-card__val">{item.value}</strong>
                      <small class="tariff-card__note">{item.note}</small>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- SENTEZ KÖPRÜSÜ -->
            <div class="synthesis-bridge reveal">
              <div class="synthesis-bridge__icon" aria-hidden="true">⇄</div>
              <div>
                <h4>{stage.synthesisBridge.title}</h4>
                <p set:html={stage.synthesisBridge.bodyHtml} />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- SAHNE 05: AKTÖR KADER KARTLARI -->
<section
  id="sahne-ihanet"
  class="section-shell"
  data-flip-back-label={fatesHeader.flipBackText || '← 1098’deki Hesabına Dön'}
>
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">{fatesHeader.eyebrow}</span>
      <h2 class="section-title">{fatesHeader.title}</h2>
      <p class="section-lead" set:html={fatesHeader.leadHtml} />
    </div>

    <div class="fates-grid">
      {
        actors.map((actor, idx) => (
          <article
            class:list={['fate-card', 'reveal', `fate-card--${actor.stance}`]}
            style={`--delay: ${idx * 65}ms`}
            data-fate-card
            data-flipped="false"
            tabindex="0"
            role="button"
            aria-label={`${actor.name} kartını çevir`}
          >
            <div class="fate-card__head">
              <span class:list={['pill', actor.stance === 'loyal' ? 'pill--turquoise' : 'pill--west']}>
                {actor.badgeText ||
                  (actor.stance === 'loyal' ? 'SON ANA KADAR DİRENEN' : 'SABOTAJ / ÇEKİLME AKTÖRÜ')}
              </span>
              <span class="fate-card__end">{actor.endDate}</span>
            </div>

            <h3 class="fate-card__name">{actor.name}</h3>
            <p class="fate-card__role">{actor.role}</p>

            <div class="fate-card__body">
              <div class="fate-face fate-face--calc">
                <span class="fate-face__label">{fatesHeader.frontLabel || '28 HAZİRAN 1098’DEKİ HESABI'}</span>
                <p>{actor.calculation1098}</p>
              </div>

              <div class="fate-face fate-face--payback">
                <span class="fate-face__label fate-face__label--after">
                  {fatesHeader.backLabel || 'SONRASINDA YAŞADIĞI AKIBET'}
                </span>
                <p>{actor.historicalPayback}</p>
              </div>
            </div>

            <div class="fate-card__footer">
              <span data-fate-cta>Akıbetini Görmek İçin Tıklayın ↻</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initSplitAndFates() {
    const origBtn = document.getElementById('toggle-original-scripts');
    const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-chronicle-stage]'));

    origBtn?.addEventListener('click', () => {
      stages.forEach((st) => st.classList.toggle('show-originals'));
    });

    const fatesSec = document.getElementById('sahne-ihanet');
    const flipBackLabel = fatesSec?.dataset.flipBackLabel || '← Önceki Yüze Dön';

    const fateCards = Array.from(document.querySelectorAll<HTMLElement>('[data-fate-card]'));
    const toggleFate = (card: HTMLElement) => {
      const next = card.dataset.flipped !== 'true';
      card.dataset.flipped = String(next);
      const cta = card.querySelector('[data-fate-cta]');
      if (cta) {
        cta.textContent = next ? flipBackLabel : 'Akıbetini Görmek İçin Tıklayın ↻';
      }
    };

    fateCards.forEach((card) => {
      card.addEventListener('click', () => toggleFate(card));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleFate(card);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initSplitAndFates);
</script>

<style>
  .chronicle-stage-block--subsequent {
    margin-top: 4.2rem;
    padding-top: 3.4rem;
    border-top: 1px solid var(--border-subtle);
  }

  .substage-header {
    max-width: 820px;
    margin-bottom: 1.75rem;
  }

  .substage-header h3 {
    font-size: clamp(1.75rem, 2.8vw, 2.3rem);
    margin: 0.7rem 0 0.5rem;
  }

  .substage-header p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .battle-banner {
    margin: 0 0 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border-crimson);
    box-shadow: var(--shadow-deep);
  }

  .battle-banner__frame {
    position: relative;
    height: clamp(240px, 36vw, 410px);
    overflow: hidden;
    background: #090b10;
  }

  .battle-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .battle-banner__img.is-engraving {
    filter: sepia(0.28) contrast(1.08) brightness(0.88);
  }

  .battle-banner__badge {
    position: absolute;
    top: 0.9rem;
    left: 0.95rem;
    padding: 0.3rem 0.72rem;
    border-radius: 999px;
    background: rgba(8, 10, 15, 0.86);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-crimson);
    color: #ff8a9e;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .battle-banner__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.2rem;
    padding: 0.82rem 1.2rem;
    background: rgba(14, 18, 27, 0.96);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
  }

  .battle-banner__cap strong {
    color: var(--text-primary);
  }

  .battle-banner__cap span {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .orig-toggle-btn {
    margin-top: 1.2rem;
    padding: 0.65rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .orig-toggle-btn:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold);
  }

  .split-chronicles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem;
    margin-bottom: 1.8rem;
  }

  .chronicle-col {
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-deep);
  }

  .chronicle-col--east {
    border-top: 3px solid var(--accent-gold);
  }

  .chronicle-col--west {
    border-top: 3px solid var(--accent-crimson);
  }

  .chronicle-col__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }

  .chronicle-date {
    font-size: 0.76rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .chronicle-col h3 {
    font-size: 1.72rem;
    margin-bottom: 0.3rem;
  }

  .chronicle-author {
    font-size: 0.83rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .orig-script {
    display: none;
    margin-bottom: 1.2rem;
    padding: 1rem 1.15rem;
    border-radius: 10px;
    background: rgba(5, 6, 10, 0.72);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .split-chronicles.show-originals .orig-script {
    display: block;
  }

  .orig-script--arabic {
    font-family: var(--font-arabic);
    font-size: 1.16rem;
    line-height: 1.95;
    color: #edd7b4;
  }

  .orig-script--latin {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.04rem;
    line-height: 1.65;
    color: #e4cad0;
  }

  .orig-script--greek {
    font-family: 'Palatino Linotype', 'Book Antiqua', Georgia, var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.75;
    color: #e6ced5;
    letter-spacing: 0.01em;
  }

  .chronicle-translation :global(p) {
    font-family: var(--font-serif);
    font-size: 1.16rem;
    line-height: 1.68;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .chronicle-translation :global(.hl-east) {
    background: rgba(217, 155, 78, 0.22);
    color: #fff5e4;
    padding: 0.05rem 0.28rem;
    border-radius: 4px;
  }

  .chronicle-translation :global(.hl-west) {
    background: rgba(217, 72, 95, 0.24);
    color: #ffe8ec;
    padding: 0.05rem 0.28rem;
    border-radius: 4px;
  }

  .tariff-box {
    margin-bottom: 1.8rem;
    padding: 1.65rem 1.8rem;
    border-radius: var(--radius-lg);
    background: rgba(14, 24, 29, 0.86);
    border: 1px solid rgba(44, 197, 179, 0.32);
  }

  .tariff-box__head h4 {
    font-size: 1.45rem;
    margin: 0.65rem 0 0.35rem;
  }

  .tariff-box__head p {
    margin: 0 0 1.2rem;
    font-size: 0.9rem;
  }

  .tariff-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .tariff-card {
    padding: 1rem 1.05rem;
    border-radius: var(--radius-md);
    background: rgba(8, 10, 15, 0.68);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }

  .tariff-card__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tariff-card__val {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    color: var(--accent-gold);
  }

  .tariff-card__note {
    font-size: 0.76rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .synthesis-bridge {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 1.15rem;
    align-items: center;
    padding: 1.6rem 1.8rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(90deg, rgba(217, 155, 78, 0.11), rgba(217, 72, 95, 0.11));
    border: 1px solid rgba(243, 237, 226, 0.15);
  }

  .synthesis-bridge__icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    background: rgba(8, 9, 13, 0.65);
    color: var(--accent-gold);
    border: 1px solid var(--border-gold);
  }

  .synthesis-bridge h4 {
