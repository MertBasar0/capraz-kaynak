---
import {
  armySegments as defaultSegments,
  berkyarukReasons as defaultReasons,
  sceneHeroVisuals,
  type VisualAsset,
} from '../data/antakya1098';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  campVisual?: VisualAsset;
  commander?: {
    pill: string;
    name: string;
    subtitle: string;
    highlightBox: {
      leftTitle: string;
      leftHtml: string;
      operator?: string;
      rightTitle: string;
      rightHtml: string;
    };
    factsHtml: string[];
  };
  reasonsPanel?: {
    pill: string;
    title: string;
    items: { num: string; title: string; text: string }[];
  };
  coalition?: {
    pill: string;
    title: string;
    verdictHtml: string;
    barAriaLabel?: string;
    segments: typeof defaultSegments;
  };
}

const {
  eyebrow = 'SAHNE 03 · KOMUTAN VE KOALİSYON ANATOMİSİ',
  title = 'Kürboğa Kimdi, Ordunun Yüzde Kaçı Türktü?',
  lead =
    'Antakya önüne gelen devasa ordu homojen bir ulus ordusu muydu, yoksa kırılgan bir feodal koalisyon mu? Başkomutan Kıvâmüddevle Kürboğa’nın kökenini, Sultan Berkyaruk’un tercihini ve ordudaki etnik dağılımı inceleyelim.',
  campVisual = sceneHeroVisuals.coalitionCamp,
  commander = {
    pill: 'KİMLİK VE ETİMOLOJİ DOSYASI',
    name: 'Kıvâmüddevle Kürboğa',
    subtitle: 'Musul Atabeyi / Emîri (Ölümü: Ağustos 1102, Hoy)',
    highlightBox: {
      leftTitle: 'KÜR',
      leftHtml: 'Dîvânu Lugâti’t-Türk’te: <em>"Pek yürekli, sarsılmaz, yiğit, dikbaşlı/mağrur"</em>',
      operator: '+',
      rightTitle: 'BOĞA',
      rightHtml: 'Eski Türk askeri unvanlarında güç ve hâkimiyet sembolü (kardeşi: <em>Altuntaş</em>)',
    },
    factsHtml: [
      '<strong>Etnik ve Sosyal Köken:</strong> Kesin olarak <strong>Türk (Kıpçak / Türkmen kuşağı)</strong> ve <strong>gulâm (memlûk)</strong> kökenlidir. Ünlü Selçuklu Halep Valisi Kasîmüddevle Aksungur’un (İmâdüddin Zengî’nin babası) askeri hassa subayı olarak yetişmiştir.',
      '<strong>Batı Kaynaklarındaki İmajı:</strong> Latin kroniklerinde <em>Curbaram / Corbagath</em> adıyla Doğu’nun en kudretli ve en korkulan başkomutanı olarak tasvir edilir.',
      '<strong>Bozgun Sonrası Akıbeti:</strong> 1098 yenilgisine rağmen Musul hâkimiyetini korudu, Sultan Berkyaruk’a sadık kaldı ve 4 yıl sonra Azerbaycan seferinde Hoy yakınlarında hastalanarak öldü.',
    ],
  },
  reasonsPanel = {
    pill: 'STRATEJİK PERDE ARKASI',
    title: 'Sultan Berkyaruk Komutayı Neden Bizzat Almadı da Kürboğa’ya Verdi?',
    items: defaultReasons,
  },
  coalition = {
    pill: 'KOALİSYON ANATOMİSİ',
    title: 'Bu Ordu Bir "Türk Ordusu" Sayılır mıydı?',
    verdictHtml:
      '<strong>Tarihsel Hüküm:</strong> Komuta kademesi (%90+), dil ve atlı okçu bozkır taktiği açısından tam bir <strong>Selçuklu Türk ordusu</strong>; yapısal açıdan ise Türk omurgalı, çok uluslu ve birbirine güvenmeyen özerk beylerden kurulu bir <strong>feodal İslam koalisyonuydu</strong>.',
    barAriaLabel: 'Koalisyon ordusu tahmini bileşim çubuğu',
    segments: defaultSegments,
  },
} = Astro.props;
---

<section id="sahne-ordu" class="section-shell">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="section-title">{title}</h2>
      <p class="section-lead">{lead}</p>
    </div>

    {
      campVisual && (
        <figure class="camp-banner reveal">
          <div class="camp-banner__frame">
            <img
              src={campVisual.src}
              alt={campVisual.caption}
              class:list={['camp-banner__img', { 'is-engraving': campVisual.isEngraving }]}
              style={`object-position: ${campVisual.objectPosition || 'center'}`}
              loading="lazy"
            />
            <span class="camp-banner__badge">{campVisual.badge}</span>
          </div>
          <figcaption class="camp-banner__cap">
            <strong>{campVisual.caption}</strong>
            <span>{campVisual.credit}</span>
          </figcaption>
        </figure>
      )
    }

    <!-- Top Row: Commander Profile + Strategic Reasons -->
    <div class="kerbogha-grid">
      <article class="kerbogha-card reveal">
        <span class="pill pill--turquoise">{commander.pill}</span>
        <h3>{commander.name}</h3>
        <p class="kerbogha-card__sub">{commander.subtitle}</p>

        <div class="etymology-box">
          <div>
            <strong>{commander.highlightBox.leftTitle}</strong>
            <span set:html={commander.highlightBox.leftHtml} />
          </div>
          <span class="etymology-plus">{commander.highlightBox.operator || '+'}</span>
          <div>
            <strong>{commander.highlightBox.rightTitle}</strong>
            <span set:html={commander.highlightBox.rightHtml} />
          </div>
        </div>

        <ul class="kerbogha-facts">
          {commander.factsHtml.map((factHtml) => <li set:html={factHtml} />)}
        </ul>
      </article>

      <div class="reasons-panel reveal" style="--delay: 110ms">
        <div class="reasons-panel__head">
          <span class="pill pill--east">{reasonsPanel.pill}</span>
          <h3>{reasonsPanel.title}</h3>
        </div>

        <div class="reasons-list">
          {
            reasonsPanel.items.map((r) => (
              <div class="reason-item">
                <span class="reason-num">{r.num}</span>
                <div>
                  <h4>{r.title}</h4>
                  <p>{r.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Bottom Row: Interactive Ethnic & Institutional Composition Bar & Breakdown -->
    <div class="coalition-box reveal" id="coalition-meter">
      <div class="coalition-box__top">
        <div>
          <span class="pill pill--east">{coalition.pill}</span>
          <h3>{coalition.title}</h3>
        </div>
        <p class="coalition-verdict" set:html={coalition.verdictHtml} />
      </div>

      <!-- Stacked Animated Bar -->
      <div class="stacked-bar" role="img" aria-label={coalition.barAriaLabel || 'Ordu bileşim çubuğu'}>
        {
          coalition.segments.map((seg, idx) => (
            <button
              type="button"
              class:list={['stacked-bar__seg', { 'is-selected': idx === 0 }]}
              style={`--seg-width: ${seg.percent}%; --seg-color: ${seg.color}`}
              data-army-seg={seg.id}
            >
              <span class="stacked-bar__pct">~%{seg.percent}</span>
            </button>
          ))
        }
      </div>

      <div class="segments-grid">
        {
          coalition.segments.map((seg, idx) => (
            <div
              class:list={['seg-card', { 'is-selected': idx === 0 }]}
              data-army-card={seg.id}
              style={`--seg-color: ${seg.color}`}
            >
              <div class="seg-card__head">
                <span class="seg-dot" style={`background:${seg.color}`} />
                <span class="seg-share">{seg.shareText}</span>
              </div>
              <h4>{seg.label}</h4>
              <div class="seg-cmd">{seg.commandNote}</div>
              <p>{seg.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function initArmyInteractive() {
    const segBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-army-seg]'));
    const segCards = Array.from(document.querySelectorAll<HTMLElement>('[data-army-card]'));

    const selectSeg = (id: string) => {
      segBtns.forEach((b) => b.classList.toggle('is-selected', b.dataset.armySeg === id));
      segCards.forEach((c) => c.classList.toggle('is-selected', c.dataset.armyCard === id));
    };

    segBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.armySeg) selectSeg(btn.dataset.armySeg);
      });
    });

    segCards.forEach((card) => {
      card.addEventListener('click', () => {
        if (card.dataset.armyCard) selectSeg(card.dataset.armyCard);
      });
    });
  }

  document.addEventListener('astro:page-load', initArmyInteractive);
</script>

<style>
  .camp-banner {
    margin: 0 0 2.2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border-gold);
    box-shadow: var(--shadow-deep);
  }

  .camp-banner__frame {
    position: relative;
    height: clamp(240px, 34vw, 390px);
    overflow: hidden;
    background: #090b10;
  }

  .camp-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .camp-banner__img.is-engraving {
    filter: sepia(0.26) contrast(1.08) brightness(0.9);
  }

  .camp-banner__badge {
    position: absolute;
    top: 0.9rem;
    left: 0.95rem;
    padding: 0.3rem 0.72rem;
    border-radius: 999px;
    background: rgba(8, 10, 15, 0.86);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-gold);
    color: var(--accent-gold);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .camp-banner__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.2rem;
    padding: 0.82rem 1.2rem;
    background: rgba(14, 18, 27, 0.96);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
  }

  .camp-banner__cap strong {
    color: var(--text-primary);
  }

  .camp-banner__cap span {
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .kerbogha-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1.6rem;
    margin-bottom: 2.4rem;
  }

  .kerbogha-card,
  .reasons-panel,
  .coalition-box {
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
  }

  .kerbogha-card h3 {
    font-size: 2.05rem;
    margin-top: 0.85rem;
  }

  .kerbogha-card__sub {
    font-size: 0.86rem;
    color: var(--accent-gold);
    margin-bottom: 1.25rem;
  }

  .etymology-box {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius-md);
    background: rgba(44, 197, 179, 0.07);
    border: 1px solid rgba(44, 197, 179, 0.25);
    margin-bottom: 1.35rem;
  }

  .etymology-box > div > strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.18rem;
    color: var(--accent-turquoise);
    margin-bottom: 0.2rem;
  }

  .etymology-box span {
    font-size: 0.78rem;
    line-height: 1.48;
    color: var(--text-secondary);
  }

  .etymology-box :global(strong) {
    color: var(--text-primary);
  }

  .etymology-plus {
    font-size: 1.3rem !important;
    font-weight: 700;
    color: var(--accent-gold) !important;
  }

  .kerbogha-facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .kerbogha-facts li {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-secondary);
    padding-left: 1rem;
    border-left: 2px solid rgba(243, 237, 226, 0.16);
  }

  .kerbogha-facts :global(strong) {
    color: var(--text-primary);
  }

  .reasons-panel__head h3 {
    font-size: 1.65rem;
    margin: 0.8rem 0 1.25rem;
  }

  .reasons-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .reason-item {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 0.85rem;
    padding: 0.95rem 1rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--border-subtle);
  }

  .reason-num {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--accent-gold);
    line-height: 1;
  }

  .reason-item h4 {
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
  }

  .reason-item p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .coalition-box__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: flex-end;
    margin-bottom: 1.6rem;
  }

  .coalition-box__top h3 {
    font-size: 1.9rem;
    margin-top: 0.7rem;
  }

  .coalition-verdict {
    max-width: 580px;
    margin: 0;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-md);
    background: rgba(217, 155, 78, 0.08);
    border-left: 3px solid var(--accent-gold);
    font-size: 0.88rem;
    color: var(--text-primary);
  }

  .stacked-bar {
    display: flex;
    width: 100%;
    height: 44px;
    border-radius: 12px;
    overflow: hidden;
    gap: 4px;
    margin-bottom: 1.5rem;
    background: rgba(0, 0, 0, 0.35);
    padding: 4px;
  }

  .stacked-bar__seg {
    width: var(--seg-width);
    background: var(--seg-color);
    border: none;
    border-radius: 8px;
    color: #08090d;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.78rem;
    cursor: pointer;
    opacity: 0.78;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stacked-bar__seg:hover,
  .stacked-bar__seg.is-selected {
    opacity: 1;
    transform: scaleY(1.08);
  }

  .segments-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .seg-card {
    padding: 1.2rem;
    border-radius: var(--radius-md);
    background: rgba(9, 11, 17, 0.65);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .seg-card.is-selected,
  .seg-card:hover {
    border-color: var(--seg-color);
    background: rgba(20, 25, 36, 0.92);
    transform: translateY(-2px);
  }

  .seg-card__head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.55rem;
  }

  .seg-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .seg-share {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .seg-card h4 {
    font-size: 1.15rem;
    margin-bottom: 0.45rem;
  }

  .seg-cmd {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-gold);
    margin-bottom: 0.55rem;
  }

  .seg-card p {
    margin: 0;
    font-size: 0.83rem;
    line-height: 1.6;
  }

  @media (max-width: 980px) {
    .kerbogha-grid {
      grid-template-columns: 1fr;
    }
    .segments-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .segments-grid,
    .etymology-box {
      grid-template-columns: 1fr;
    }
  }
</style>
