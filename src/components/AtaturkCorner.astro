---
import { withBase } from '../utils/paths';

const kocatepePhotoSrc = withBase('/images/arsiv/ataturk-kocatepe-1922.jpg');
---

<section class="ataturk-corner" id="ataturk-kosesi" aria-labelledby="ataturk-corner-heading">
  <div class="ataturk-corner__glow ataturk-corner__glow--crimson" aria-hidden="true"></div>
  <div class="ataturk-corner__glow ataturk-corner__glow--gold" aria-hidden="true"></div>

  <div class="container">
    <article class="ataturk-card reveal">
      <div class="ataturk-card__content">
        <div class="ataturk-card__badges">
          <span class="ataturk-pill ataturk-pill--crimson">
            <span class="ataturk-pill__star" aria-hidden="true">★</span>
            ATATÜRK KÖŞESİ · FİKRÎ MİRAS
          </span>
          <span class="ataturk-pill ataturk-pill--archive">
            VESİKA · HAKİKAT · ELEŞTİREL AKIL
          </span>
        </div>

        <h2 id="ataturk-corner-heading" class="ataturk-card__title">
          Tarihi Yapan İradeden, Tarihi Belgeyle Yazan Bilince:
          <span>Gazi Mustafa Kemal Atatürk’ün Tarih Metodolojisi</span>
        </h2>

        <blockquote class="ataturk-card__quote">
          <p class="ataturk-card__quote-main">
            «Tarih yazmak, tarih yapmak kadar mühimdir. Yazan yapana sadık kalmazsa değişmeyen hakikat, insanlığı
            şaşırtacak bir mahiyet alır.»
          </p>
          <p class="ataturk-card__quote-sub">
            «Biz daima hakikat arayan ve onu buldukça ve bulduğumuza kani oldukça ifadeye cüret gösteren adamlar
            olmalıyız. Her işten evvel, dikkat ve itina ile seçeceğiniz vesikalara dayanınız.»
          </p>
          <footer>
            <strong>Gazi Mustafa Kemal Atatürk</strong>
            <span>16 Ağustos 1931, Yalova · Türk Tarihi Tetkik Cemiyeti’ne Yönerge Mektubu</span>
          </footer>
        </blockquote>

        <p class="ataturk-card__body">
          <strong>Çapraz Kaynak</strong>’ın karşı cephelerin vekâyinâmelerini yan yana getiren yayın çizgisi,
          Atatürk’ün bizzat <em>Nutuk</em>’u yüzlerce numaralı birincil <strong>Vesikalar</strong> cildiyle
          temellendiren ve geçmişi ikinci el söylenceler yerine <strong>ana kaynak dillerinden</strong> okuma
          geleneğini kuran belge merkezli tarih anlayışından ilham alır.
        </p>
      </div>

      <figure class="ataturk-card__media">
        <div class="ataturk-card__frame">
          <img
            src={kocatepePhotoSrc}
            alt="Başkomutan Gazi Mustafa Kemal Paşa, 26 Ağustos 1922 Büyük Taarruz sabahı Afyonkarahisar Kocatepe gözetleme yerinde kalpaklı cephe üniformasıyla"
            width="1200"
            height="799"
            loading="eager"
            decoding="async"
          />
          <span class="ataturk-card__frame-badge">CEPHE VESİKASI · KOCATEPE · 26 AĞUSTOS 1922</span>
        </div>
        <figcaption class="ataturk-card__caption">
          <strong>Afyonkarahisar · Kocatepe Gözetleme Yeri (26 Ağustos 1922 Sabahı)</strong>
          <span>
            Başkomutan Gazi Mustafa Kemal Paşa Büyük Taarruz’un başladığı saatlerde cephe hattında · Fotoğraf: Etem
            Hamdi Tem (Kamu Malı Birincil Arşiv Kaydı)
          </span>
        </figcaption>
      </figure>
    </article>
  </div>
</section>

<style>
  .ataturk-corner {
    position: relative;
    padding: 2.6rem 0 0.6rem;
    scroll-margin-top: 76px;
    overflow: hidden;
  }

  .ataturk-corner__glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 0;
  }

  .ataturk-corner__glow--crimson {
    top: -120px;
    left: 6%;
    width: 480px;
    height: 320px;
    background: rgba(217, 72, 95, 0.15);
  }

  .ataturk-corner__glow--gold {
    bottom: -100px;
    right: 8%;
    width: 440px;
    height: 290px;
    background: rgba(217, 155, 78, 0.13);
  }

  .ataturk-card {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
    gap: 2.4rem;
    align-items: center;
    padding: 2.35rem 2.5rem;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, rgba(26, 18, 24, 0.88) 0%, rgba(16, 19, 28, 0.95) 52%, rgba(20, 22, 31, 0.96) 100%);
    border: 1px solid rgba(217, 155, 78, 0.34);
    box-shadow:
      0 26px 68px rgba(0, 0, 0, 0.56),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .ataturk-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(125deg, rgba(217, 72, 95, 0.5), rgba(217, 155, 78, 0.46), rgba(255, 255, 255, 0.04));
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .ataturk-card__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .ataturk-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.34rem 0.78rem;
    border-radius: 999px;
    font-size: 0.71rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .ataturk-pill--crimson {
    background: rgba(217, 72, 95, 0.18);
    border: 1px solid rgba(217, 72, 95, 0.46);
    color: #ff98a8;
  }

  .ataturk-pill__star {
    color: #f5c27a;
    font-size: 0.78rem;
  }

  .ataturk-pill--archive {
    background: rgba(217, 155, 78, 0.1);
    border: 1px solid rgba(217, 155, 78, 0.32);
    color: var(--accent-gold);
  }

  .ataturk-card__title {
    font-size: clamp(1.72rem, 2.65vw, 2.42rem);
    line-height: 1.18;
    margin-bottom: 1.1rem;
    color: var(--text-primary);
  }

  .ataturk-card__title span {
    display: block;
    margin-top: 0.24rem;
    color: var(--accent-gold);
    font-style: italic;
    font-weight: 600;
  }

  .ataturk-card__quote {
    margin: 0 0 1.1rem;
    padding: 0.95rem 1.2rem;
    border-left: 3px solid var(--accent-gold);
    background: rgba(9, 11, 16, 0.58);
    border-radius: 0 12px 12px 0;
  }

  .ataturk-card__quote-main {
    margin: 0 0 0.5rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.12rem, 1.45vw, 1.28rem);
    line-height: 1.46;
    color: var(--text-primary);
  }

  .ataturk-card__quote-sub {
    margin: 0 0 0.58rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .ataturk-card__quote footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.75rem;
    font-size: 0.76rem;
  }

  .ataturk-card__quote strong {
    color: var(--accent-gold);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .ataturk-card__quote span {
    color: var(--text-muted);
  }

  .ataturk-card__body {
    margin: 0;
    font-size: 0.91rem;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  .ataturk-card__body strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .ataturk-card__body em {
    color: #f3d5a5;
    font-style: italic;
  }

  .ataturk-card__media {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
  }

  .ataturk-card__frame {
    position: relative;
    border-radius: 13px;
    overflow: hidden;
    aspect-ratio: 1200 / 799;
    background: #0b0d13;
    border: 1px solid rgba(217, 155, 78, 0.36);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.58);
  }

  .ataturk-card__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 46% 48%, transparent 54%, rgba(8, 9, 13, 0.46) 100%),
      linear-gradient(to top, rgba(8, 9, 13, 0.56) 0%, transparent 28%);
    pointer-events: none;
  }

  .ataturk-card__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.22) contrast(1.04) brightness(0.93);
    transition: transform 0.55s ease, filter 0.4s ease;
  }

  .ataturk-card:hover .ataturk-card__frame img {
    transform: scale(1.018);
    filter: sepia(0.16) contrast(1.06) brightness(0.96);
  }

  .ataturk-card__frame-badge {
    position: absolute;
    bottom: 0.76rem;
    right: 0.76rem;
    z-index: 2;
    padding: 0.28rem 0.66rem;
    border-radius: 999px;
    background: rgba(9, 10, 15, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(217, 155, 78, 0.38);
    color: var(--accent-gold);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ataturk-card__caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-inline: 0.2rem;
  }

  .ataturk-card__caption strong {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .ataturk-card__caption span {
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .ataturk-corner {
      padding: 1.6rem 0 0.25rem;
    }

    .ataturk-card {
      grid-template-columns: 1fr;
      gap: 1.65rem;
      padding: 1.65rem 1.45rem;
    }
  }

  @media (max-width: 560px) {
    .ataturk-card {
      padding: 1.35rem 1.15rem;
    }

    .ataturk-pill {
      font-size: 0.61rem;
      letter-spacing: 0.06em;
      padding: 0.28rem 0.6rem;
    }

    .ataturk-card__frame-badge {
      font-size: 0.55rem;
      letter-spacing: 0.06em;
      padding: 0.22rem 0.52rem;
      bottom: 0.52rem;
      right: 0.52rem;
    }
  }
</style>
