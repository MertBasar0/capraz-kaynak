---
import { withBase } from '../utils/paths';

interface ArchiveSlide {
  id: string;
  src: string;
  width: number;
  height: number;
  mode: 'cover' | 'portrait';
  badge: string;
  shortLabel: string;
  title: string;
  meta: string;
  alt: string;
}

const slides: ArchiveSlide[] = [
  {
    id: 'kocatepe-1922',
    src: withBase('/images/arsiv/ataturk-kocatepe-1922.jpg'),
    width: 1200,
    height: 799,
    mode: 'cover',
    badge: '01 / 05 · KOCATEPE · 26 AĞUSTOS 1922',
    shortLabel: '1922 Kocatepe',
    title: 'Afyonkarahisar · Kocatepe Gözetleme Yeri (26 Ağustos 1922 Sabahı)',
    meta: 'Başkomutan Gazi Mustafa Kemal Paşa Büyük Taarruz’un başladığı saatlerde kalpaklı cephe üniformasıyla · Fotoğraf: Etem Hamdi Tem (Kamu Malı Arşiv Kaydı)',
    alt: 'Başkomutan Gazi Mustafa Kemal Paşa, 26 Ağustos 1922 Büyük Taarruz sabahı Afyonkarahisar Kocatepe gözetleme yerinde kalpaklı cephe üniformasıyla',
  },
  {
    id: 'canakkale-1915',
    src: withBase('/images/arsiv/ataturk-canakkale-1915.jpg'),
    width: 1200,
    height: 801,
    mode: 'cover',
    badge: '02 / 05 · ÇANAKKALE SİPERİ · 1915',
    shortLabel: '1915 Çanakkale',
    title: 'Gelibolu · Çanakkale Cephesi Siper Hattı (1915)',
    meta: 'Anafartalar ve Arıburnu muharebeleri sırasında Albay Mustafa Kemal ön hat siperinde kurmaylarıyla gözetleme yaparken (Kamu Malı Birincil Arşiv Kaydı)',
    alt: 'Çanakkale Cephesi siper hattında kurmaylarıyla gözetleme yapan Mustafa Kemal (1915)',
  },
  {
    id: 'bati-cephesi-1921',
    src: withBase('/images/arsiv/ataturk-bati-cephesi-1921.jpg'),
    width: 1200,
    height: 801,
    mode: 'cover',
    badge: '03 / 05 · BATI CEPHESİ KARARGÂHI · 1921',
    shortLabel: '1921 Cephe',
    title: 'Batı Cephesi · Karargâh Çadırı Önünde Kalpaklı Heyet (1921)',
    meta: 'TBMM Reisi Mustafa Kemal Paşa kalpaklı cephe kaputuyla; heyette sonradan Türk Tarihi Tetkik Cemiyeti Reisliği yapacak Tevfik Bıyıklıoğlu da yer alır (Kamu Malı)',
    alt: 'TBMM Reisi Mustafa Kemal Paşa kalpaklı ve kürklü cephe kaputuyla Batı Cephesi çadırı önünde kurmaylarıyla (1921)',
  },
  {
    id: 'kalpak-portre-1923',
    src: withBase('/images/arsiv/ataturk-kalpakli-portre-1923.jpg'),
    width: 961,
    height: 1375,
    mode: 'portrait',
    badge: '04 / 05 · CAM NEGATİF PORTRE · c. 1923',
    shortLabel: '1923 Kalpaklı',
    title: 'Cepheden Cumhuriyet’e · Kalpaklı Cam Negatif Portresi (c. 1923)',
    meta: 'ABD Kongre Kütüphanesi (Library of Congress · George Grantham Bain Cam Negatif Koleksiyonu, LCCN 2014716853 · Kamu Malı Birincil Arşiv Kaydı)',
    alt: 'Gazi Mustafa Kemal Atatürk’ün kalpaklı cam negatif portresi (Library of Congress, LCCN 2014716853, c. 1923)',
  },
  {
    id: 'kayseri-karatahta-1928',
    src: withBase('/images/arsiv/ataturk-kayseri-karatahta-1928.jpg'),
    width: 1200,
    height: 801,
    mode: 'cover',
    badge: '05 / 05 · KARATAHTA BAŞI · 20 EYLÜL 1928',
    shortLabel: '1928 Karatahta',
    title: 'Kayseri · Karatahta Başında Kültür ve Bilim Seferberliği (20 Eylül 1928)',
    meta: 'Savaş meydanından kürsüye: Gazi Mustafa Kemal yeni Türk harflerini bizzat karatahta başında anlatırken (Nationaal Archief · SFA003017841 · Kamu Malı)',
    alt: 'Gazi Mustafa Kemal Atatürk, 20 Eylül 1928 tarihinde Kayseri’de Türk bayrakları altında karatahta başında yeni harfleri anlatırken',
  },
];
---

<section class="ataturk-corner" id="ataturk-kosesi" aria-labelledby="ataturk-corner-heading">
  <div class="ataturk-corner__glow ataturk-corner__glow--crimson" aria-hidden="true"></div>
  <div class="ataturk-corner__glow ataturk-corner__glow--gold" aria-hidden="true"></div>

  <div class="container">
    <article class="ataturk-card reveal">
      <div class="ataturk-mourning-head">
        <div class="ataturk-mourning-head__left">
          <span class="ataturk-mourning-ribbon" aria-hidden="true">
            <svg width="20" height="24" viewBox="0 0 24 28" fill="none">
              <path
                d="M7.2 24.2L12 15.6L16.8 24.2M12 15.6L8 9.2C6.5 6.8 8.1 3.6 11 3.3C11.7 3.2 12.3 3.2 13 3.3C15.9 3.6 17.5 6.8 16 9.2L12 15.6Z"
                stroke="#f1f5f9"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M8.7 8.6C7.6 6.7 8.9 4.3 11.2 4.1C11.7 4 12.3 4 12.8 4.1C15.1 4.3 16.4 6.7 15.3 8.6L12 14.1L8.7 8.6Z"
                fill="#07090e"
              />
            </svg>
          </span>
          <div class="ataturk-mourning-head__titles">
            <span class="ataturk-mourning-head__eyebrow">10 KASIM 1938 · DOLMABAHÇE · SAAT 09.05</span>
            <strong class="ataturk-mourning-head__dates">
              Gazi Mustafa Kemal Atatürk <span class="mourning-nowrap">(1881 – 1938 · ∞)</span>
            </strong>
          </div>
        </div>
        <span class="ataturk-mourning-head__commemoration">
          VEFATININ <span data-mourning-years-text>88</span>. YILINDA SAYGI, ÖZLEM VE MİNNETLE
        </span>
      </div>

      <div class="ataturk-card__content">
        <div class="ataturk-card__badges">
          <span class="ataturk-pill ataturk-pill--crimson">
            <span class="ataturk-pill__star" aria-hidden="true">★</span>
            ATATÜRK KÖŞESİ · FİKRÎ MİRAS
          </span>
          <span class="ataturk-pill ataturk-pill--archive">
            VESİKA · HAKİKAT · ELEŞTİREL AKIL
          </span>
        </div>

        <h2 id="ataturk-corner-heading" class="ataturk-card__title">
          Tarihi Yapan İradeden, Tarihi Belgeyle Yazan Bilince:
          <span>Gazi Mustafa Kemal Atatürk’ün Tarih Metodolojisi</span>
        </h2>

        <blockquote class="ataturk-card__quote">
          <p class="ataturk-card__quote-main">
            «Tarih yazmak, tarih yapmak kadar mühimdir. Yazan yapana sadık kalmazsa değişmeyen hakikat, insanlığı
            şaşırtacak bir mahiyet alır.»
          </p>
          <p class="ataturk-card__quote-sub">
            «Biz daima hakikat arayan ve onu buldukça ve bulduğumuza kani oldukça ifadeye cüret gösteren adamlar
            olmalıyız. Her işten evvel, dikkat ve itina ile seçeceğiniz vesikalara dayanınız.»
          </p>
          <footer>
            <strong>Gazi Mustafa Kemal Atatürk</strong>
            <span>16 Ağustos 1931, Yalova · Türk Tarihi Tetkik Cemiyeti’ne Yönerge Mektubu</span>
          </footer>
        </blockquote>

        <p class="ataturk-card__body">
          <strong>Çapraz Kaynak</strong>’ın karşı cephelerin vekâyinâmelerini yan yana getiren yayın çizgisi,
          Atatürk’ün bizzat <em>Nutuk</em>’u yüzlerce numaralı birincil <strong>Vesikalar</strong> cildiyle
          temellendiren ve geçmişi ikinci el söylenceler yerine <strong>ana kaynak dillerinden</strong> okuma
          geleneğini kuran belge merkezli tarih anlayışından ilham alır.
        </p>
      </div>

      <figure
        class="ataturk-carousel"
        data-ataturk-carousel
        tabindex="0"
        aria-roledescription="karusel"
        aria-label="Gazi Mustafa Kemal Atatürk birincil arşiv fotoğrafları seçkisi"
      >
        <div class="ataturk-carousel__viewport">
          {
            slides.map((slide, idx) => (
              <div
                class:list={[
                  'ataturk-carousel__slide',
                  { 'is-active': idx === 0, 'is-portrait': slide.mode === 'portrait' },
                ]}
                data-slide-index={idx}
                data-badge={slide.badge}
                data-title={slide.title}
                data-meta={slide.meta}
                aria-hidden={idx === 0 ? 'false' : 'true'}
              >
                {slide.mode === 'portrait' && (
                  <img
                    src={slide.src}
                    alt=""
                    aria-hidden="true"
                    class="ataturk-carousel__backdrop"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <img
                  src={slide.src}
                  alt={slide.alt}
                  width={slide.width}
                  height={slide.height}
                  loading={idx === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="ataturk-carousel__img"
                />
              </div>
            ))
          }

          <button
            type="button"
            class="ataturk-carousel__nav ataturk-carousel__nav--prev"
            data-carousel-prev
            aria-label="Önceki arşiv fotoğrafı"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <button
            type="button"
            class="ataturk-carousel__nav ataturk-carousel__nav--next"
            data-carousel-next
            aria-label="Sonraki arşiv fotoğrafı"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <span class="ataturk-carousel__badge" data-carousel-badge>{slides[0].badge}</span>
        </div>

        <div class="ataturk-carousel__controls" role="tablist" aria-label="Arşiv kareleri">
          {
            slides.map((slide, idx) => (
              <button
                type="button"
                role="tab"
                class:list={['ataturk-carousel__dot', { 'is-active': idx === 0 }]}
                data-carousel-dot={idx}
                aria-selected={idx === 0 ? 'true' : 'false'}
                aria-label={`${idx + 1}. kare: ${slide.shortLabel}`}
                title={slide.shortLabel}
              >
                <span class="ataturk-carousel__dot-label">{slide.shortLabel}</span>
              </button>
            ))
          }
        </div>

        <figcaption class="ataturk-carousel__caption" aria-live="polite">
          <strong data-carousel-title>{slides[0].title}</strong>
          <span data-carousel-meta>{slides[0].meta}</span>
        </figcaption>
      </figure>

      <div class="ataturk-mourning-docs" aria-label="10 Kasım 1938 Çapraz Birincil Vesikalar">
        <div class="ataturk-mourning-docs__head">
          <span class="ataturk-mourning-docs__pill">10 KASIM 1938 · ÇAPRAZ BİRİNCİL VESİKALAR</span>
          <h3>Aynı Tarihsel An, İki Cephenin Kaydı: Ankara Resmî Tebliği ve Dünya Tanıklığı</h3>
        </div>

        <div class="ataturk-mourning-docs__grid">
          <div class="mourning-doc-card">
            <span class="mourning-doc-card__tag">
              ANKARA &amp; DOLMABAHÇE · RESMÎ DEVLET VESİKASI · DOĞRUDAN ALINTI
            </span>
            <h4>Son Tabip Raporu ve Türkiye Cumhuriyeti Hükûmetinin Resmî Tebliği</h4>
            <span class="mourning-doc-card__source">
              T.C. Resmî Gazete, 10 İkinciteşrin [Kasım] 1938, Sayı: 4059
            </span>
            <p class="mourning-doc-card__quote">
              «[...] bugün, 10 İkinciteşrin 1938 Perşembe sabahı saat dokuzu beş geçe Büyük Şefimiz derin koma içinde
              terki hayat etmişlerdir.»
            </p>
            <p class="mourning-doc-card__quote">
              «Müdavi ve müşavir tabiplerin neşredilen son raporu Atatürk’ün dünyaya gözlerini kapadığını
              bildirmektedir. Bu acı hadise ile Türk vatanı büyük yapıcısını, Türk milleti Ulu Şefi’ni, insanlık büyük
              evladını kaybetti. [...] Şurasını da her şeyden evvel beyan etmeliyiz ki ölmez olan, onun büyük eseri
              Cumhuriyet Türkiyesi’dir.»
            </p>
          </div>

          <div class="mourning-doc-card mourning-doc-card--world">
            <span class="mourning-doc-card__tag">
              LONDRA &amp; ATİNA · ESKİ KARŞI CEPHELERİN ÇAĞDAŞ KAYDI · DOĞRUDAN ALINTI (ÇEVİRİ) &amp; KAYNAK ÖZETİ
            </span>
            <h4>Winston S. Churchill (1915 Çanakkale Bahriye Birinci Lordu) ve Başbakan İoannis Metaksas</h4>
            <span class="mourning-doc-card__source">
              Daily Telegraph and Morning Post, 15 Aralık 1938 (Step by Step, 1939 · İngilizce aslından çeviri) &amp;
              Kasım 1938 Diplomatik Taziye Kaydı
            </span>
            <p class="mourning-doc-card__quote">
              «Her sınıftan kadın ve erkeğin onun tabutu başında döktüğü gözyaşları; aynı anda hem modern Türkiye’nin
              kahramanı, hem savunucusu hem de babası olan bir devlet adamının hayat eserine yakışan en haklı saygı
              duruşuydu. [...] Hayranlık uyandıran bir itidal ve iyi niyet politikasıyla, tarihte ilk kez Yunanistan
              ile en dostane ilişkileri kurdu.»
            </p>
            <p class="mourning-doc-card__summary">
              <em>Kaynak Özeti (Atina–Ankara, Kasım 1938):</em> Yunanistan Başbakanı İoannis Metaksas da Başbakan Celâl
              Bayar’a çektiği resmî taziye telgrafında Atatürk’ü ortak idealler ve barışçıl iş birliğine dayalı
              Türk–Yunan dostluğunun gerçek kurucusu olarak selamlamış; bizzat Ankara’ya gelerek 21 Kasım 1938’deki
              devlet cenaze töreninde saf tutmuştur.
            </p>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  let cleanupCarousel: (() => void) | null = null;

  function initAtaturkCarousel() {
    if (cleanupCarousel) {
      cleanupCarousel();
      cleanupCarousel = null;
    }

    const root = document.querySelector<HTMLElement>('[data-ataturk-carousel]');
    if (!root) return;

    const slideEls = Array.from(root.querySelectorAll<HTMLElement>('[data-slide-index]'));
    const dotEls = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const badgeEl = root.querySelector<HTMLElement>('[data-carousel-badge]');
    const titleEl = root.querySelector<HTMLElement>('[data-carousel-title]');
    const metaEl = root.querySelector<HTMLElement>('[data-carousel-meta]');

    if (slideEls.length < 2) return;

    let current = 0;
    let paused = false;
    let userLocked = false;
    let timerId: number | null = null;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const goTo = (index: number) => {
      const total = slideEls.length;
      current = ((index % total) + total) % total;

      slideEls.forEach((el, idx) => {
        const active = idx === current;
        el.classList.toggle('is-active', active);
        el.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      dotEls.forEach((dot, idx) => {
        const active = idx === current;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      const activeSlide = slideEls[current];
      if (badgeEl && activeSlide.dataset.badge) badgeEl.textContent = activeSlide.dataset.badge;
      if (titleEl && activeSlide.dataset.title) titleEl.textContent = activeSlide.dataset.title;
      if (metaEl && activeSlide.dataset.meta) metaEl.textContent = activeSlide.dataset.meta;
    };

    const stopTimer = () => {
      if (timerId !== null) {
        window.clearInterval(timerId);
        timerId = null;
      }
    };

    const startTimer = () => {
      stopTimer();
      if (prefersReducedMotion || paused || userLocked) return;
      timerId = window.setInterval(() => {
        goTo(current + 1);
      }, 6800);
    };

    const onPrev = () => {
      userLocked = true;
      goTo(current - 1);
      stopTimer();
    };

    const onNext = () => {
      userLocked = true;
      goTo(current + 1);
      stopTimer();
    };

    prevBtn?.addEventListener('click', onPrev);
    nextBtn?.addEventListener('click', onNext);

    const dotHandlers = dotEls.map((dot, idx) => {
      const handler = () => {
        userLocked = true;
        goTo(idx);
        stopTimer();
      };
      dot.addEventListener('click', handler);
      return { dot, handler };
    });

    const onMouseEnter = () => {
      paused = true;
      stopTimer();
    };
    const onMouseLeave = () => {
      paused = false;
      startTimer();
    };
    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        onPrev();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        onNext();
      }
    };

    let touchStartX = 0;
    let touchStartY = 0;
    const onTouchStart = (e: TouchEvent) => {
      if (e.touches.length !== 1) return;
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    };
    const onTouchEnd = (e: TouchEvent) => {
      if (e.changedTouches.length !== 1) return;
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) > 38 && Math.abs(dx) > Math.abs(dy) * 1.2) {
        if (dx < 0) onNext();
        else onPrev();
      }
    };

    root.addEventListener('mouseenter', onMouseEnter);
    root.addEventListener('mouseleave', onMouseLeave);
    root.addEventListener('focusin', onMouseEnter);
    root.addEventListener('focusout', onMouseLeave);
    root.addEventListener('keydown', onKeyDown);
    root.addEventListener('touchstart', onTouchStart, { passive: true });
    root.addEventListener('touchend', onTouchEnd, { passive: true });

    if (document.documentElement.getAttribute('data-mourning') === '10-kasim' && slideEls.length > 3) {
      goTo(3);
    }

    startTimer();

    cleanupCarousel = () => {
      stopTimer();
      prevBtn?.removeEventListener('click', onPrev);
      nextBtn?.removeEventListener('click', onNext);
      dotHandlers.forEach(({ dot, handler }) => dot.removeEventListener('click', handler));
      root.removeEventListener('mouseenter', onMouseEnter);
      root.removeEventListener('mouseleave', onMouseLeave);
      root.removeEventListener('focusin', onMouseEnter);
      root.removeEventListener('focusout', onMouseLeave);
      root.removeEventListener('keydown', onKeyDown);
      root.removeEventListener('touchstart', onTouchStart);
      root.removeEventListener('touchend', onTouchEnd);
    };
  }

  document.addEventListener('astro:page-load', initAtaturkCarousel);
  document.addEventListener('astro:before-swap', () => {
    if (cleanupCarousel) {
      cleanupCarousel();
      cleanupCarousel = null;
    }
  });
</script>

<style>
  .ataturk-corner {
    position: relative;
    padding: 2.6rem 0 0.6rem;
    scroll-margin-top: 76px;
    overflow: hidden;
  }

  .ataturk-corner__glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 0;
  }

  .ataturk-corner__glow--crimson {
    top: -120px;
    left: 6%;
    width: 480px;
    height: 320px;
    background: rgba(217, 72, 95, 0.15);
  }

  .ataturk-corner__glow--gold {
    bottom: -100px;
    right: 8%;
    width: 440px;
    height: 290px;
    background: rgba(217, 155, 78, 0.13);
  }

  .ataturk-card {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.98fr);
    gap: 2.35rem;
    align-items: center;
    padding: 2.3rem 2.45rem;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, rgba(26, 18, 24, 0.88) 0%, rgba(16, 19, 28, 0.95) 52%, rgba(20, 22, 31, 0.96) 100%);
    border: 1px solid rgba(217, 155, 78, 0.34);
    box-shadow:
      0 26px 68px rgba(0, 0, 0, 0.56),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .ataturk-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(125deg, rgba(217, 72, 95, 0.5), rgba(217, 155, 78, 0.46), rgba(255, 255, 255, 0.04));
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .ataturk-card__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .ataturk-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.34rem 0.78rem;
    border-radius: 999px;
    font-size: 0.71rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .ataturk-pill--crimson {
    background: rgba(217, 72, 95, 0.18);
    border: 1px solid rgba(217, 72, 95, 0.46);
    color: #ff98a8;
  }

  .ataturk-pill__star {
    color: #f5c27a;
    font-size: 0.78rem;
  }

  .ataturk-pill--archive {
    background: rgba(217, 155, 78, 0.1);
    border: 1px solid rgba(217, 155, 78, 0.32);
    color: var(--accent-gold);
  }

  .ataturk-card__title {
    font-size: clamp(1.7rem, 2.6vw, 2.38rem);
    line-height: 1.18;
    margin-bottom: 1.08rem;
    color: var(--text-primary);
  }

  .ataturk-card__title span {
    display: block;
    margin-top: 0.24rem;
    color: var(--accent-gold);
    font-style: italic;
