---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dossiers } from '../data/catalog';
import { withBase } from '../utils/paths';
---

<BaseLayout title="Çapraz Kaynak — Birincil Kayıtlarla Karşılaştırmalı Tarih Atlası">
  <section class="home-hero">
    <div class="home-hero__ambient" aria-hidden="true"></div>
    <div class="container home-hero__inner">
      <span class="eyebrow reveal">ETKİLEŞİMLİ TARİHSEL BİLİNÇ PLATFORMU</span>

      <h1 class="home-hero__title reveal" style="--delay: 80ms">
        Tarihi Tek Tarafın Kaleminden Değil,
        <span>Karşı Cephelerin Birincil Kayıtlarından Okuyun.</span>
      </h1>

      <p class="home-hero__lead reveal" style="--delay: 160ms">
        <strong>Çapraz Kaynak</strong>, tarihin kırılma anlarını hamasete ya da tek taraflı efsanelere bırakmadan;
        dönemin Arap, Latin, Bizans, Ermeni ve Süryani vekâyinâmelerini 3B harita sahneleri ve etkileşimli kaynak
        süzgeçleriyle yan yana getirir.
      </p>

      <div class="home-hero__actions reveal" style="--delay: 240ms">
        <a href={withBase('/dosyalar/antakya-1098/')} class="btn-primary">
          <span>Dosya 01’i Başlat: Antakya 1098 &amp; Kürboğa</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={withBase('/metodoloji/')} class="btn-ghost">Kaynak Kritiği Yöntemimiz</a>
      </div>

      <!-- 3 PILLARS STRIP -->
      <div class="pillars-grid reveal" style="--delay: 320ms">
        <div class="pillar-card">
          <span class="pillar-num">01</span>
          <h3>İki Cephe, Tek An</h3>
          <p>Aynı muharebe sabahını hem Doğu hem Batı görgü tanıklarının orijinal satırlarıyla yan yana inceler.</p>
        </div>
        <div class="pillar-card">
          <span class="pillar-num">02</span>
          <h3>Propaganda Süzgeci</h3>
          <p>Kitleleri savaşa sürüklemek için üretilen kurgu metinleri bağımsız arşiv kayıtlarıyla çapraz sorgular.</p>
        </div>
        <div class="pillar-card">
          <span class="pillar-num">03</span>
          <h3>Kaydırmalı 3B Coğrafya</h3>
          <p>Siz metni kaydırdıkça harita kameraları orduların yürüyüş ve kuşatma rotalarını canlı olarak takip eder.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DOSSIERS CATALOG -->
  <section class="section-shell" id="dosyalar">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">TARİHSEL KIRILMA DOSYALARI</span>
        <h2 class="section-title">Yayın Kataloğu</h2>
        <p class="section-lead">
          Her dosya bağımsız bir etkileşimli belgesel olarak tasarlanır. İlk dosyamız yayında; sıradaki kırılma
          dosyaları aynı çapraz kaynak motoru üzerinde hazırlanmaktadır.
        </p>
      </div>

      <div class="dossier-list">
        {
          dossiers.map((d, idx) => (
            <article
              class:list={['dossier-card', 'reveal', { 'dossier-card--live': d.status === 'yayinda' }]}
              style={`--delay: ${idx * 90}ms`}
            >
              <div class="dossier-card__meta">
                <div class="dossier-card__badges">
                  <span class="dossier-num">{d.number}</span>
                  {d.status === 'yayinda' ? (
                    <span class="pill pill--turquoise">● YAYINDA · TAM ETKİLEŞİMLİ</span>
                  ) : (
                    <span class="pill">HAZIRLANIYOR</span>
                  )}
                </div>
                <span class="dossier-period">{d.period}</span>
              </div>

              <h3 class="dossier-card__title">
                {d.status === 'yayinda' ? <a href={d.slug}>{d.title}</a> : d.title}
              </h3>

              <p class="dossier-card__sub">{d.subtitle}</p>

              <blockquote class="dossier-card__hook">«{d.hookQuestion}»</blockquote>

              <div class="dossier-card__sources">
                <span class="sources-label">Çapraz Kaynaklar:</span>
                {d.witnessSources.map((s) => (
                  <span class="source-chip">{s}</span>
                ))}
              </div>

              <div class="dossier-card__footer">
                <span class="dossier-geo">{d.geography}</span>
                {d.status === 'yayinda' ? (
                  <a href={d.slug} class="dossier-open-btn">
                    Belgesel Deneyimine Gir ({d.sceneCount} Sahne · El Yazması &amp; Gravür Arşivi) →
                  </a>
                ) : (
                  <span class="dossier-soon">{d.readingTime}</span>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    padding: 5.5rem 0 4.5rem;
    overflow: hidden;
  }

  .home-hero__ambient {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 540px;
    background: radial-gradient(ellipse at center, rgba(217, 155, 78, 0.13), transparent 68%);
    pointer-events: none;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
  }

  .home-hero__title {
    font-size: clamp(2.55rem, 5.2vw, 4.4rem);
    max-width: 960px;
    margin: 0.9rem 0 1.4rem;
  }

  .home-hero__title span {
    display: block;
    color: var(--accent-gold);
    font-style: italic;
    font-weight: 500;
  }

  .home-hero__lead {
    max-width: 760px;
    font-size: clamp(1.04rem, 1.4vw, 1.18rem);
    line-height: 1.8;
    margin-bottom: 2.2rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3.6rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.95rem 1.6rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #e0a354, #c57e2c);
    color: #090a0e;
    font-weight: 700;
    font-size: 0.92rem;
    box-shadow: 0 14px 34px rgba(217, 155, 78, 0.28);
    transition: all 0.25s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(217, 155, 78, 0.42);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.95rem 1.45rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-ghost:hover {
    border-color: var(--border-gold);
    color: var(--accent-gold);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .pillar-card {
    padding: 1.45rem 1.55rem;
    border-radius: var(--radius-lg);
    background: rgba(18, 22, 32, 0.68);
    border: 1px solid var(--border-subtle);
  }

  .pillar-num {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .pillar-card h3 {
    font-size: 1.38rem;
    margin: 0.35rem 0 0.45rem;
  }

  .pillar-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.62;
  }

  .dossier-list {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .dossier-card {
    padding: 2.1rem 2.2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    transition: all 0.28s ease;
  }

  .dossier-card--live {
    border-color: var(--border-gold);
    background: linear-gradient(155deg, rgba(24, 24, 34, 0.94), rgba(14, 18, 27, 0.95));
    box-shadow: var(--shadow-deep);
  }

  .dossier-card--live:hover {
    transform: translateY(-3px);
    border-color: rgba(217, 155, 78, 0.65);
  }

  .dossier-card__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .dossier-card__badges {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .dossier-num {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--accent-gold);
  }

  .dossier-period {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .dossier-card__title {
    font-size: clamp(1.7rem, 2.8vw, 2.35rem);
    margin-bottom: 0.7rem;
  }

  .dossier-card__title a:hover {
    color: var(--accent-gold);
  }

  .dossier-card__sub {
    max-width: 880px;
    font-size: 0.98rem;
    line-height: 1.72;
    margin-bottom: 1.15rem;
  }

  .dossier-card__hook {
    margin: 0 0 1.25rem;
    padding: 0.85rem 1.1rem;
    border-left: 3px solid var(--accent-gold);
    background: rgba(217, 155, 78, 0.06);
    border-radius: 0 10px 10px 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.14rem;
    color: var(--text-primary);
  }

  .dossier-card__sources {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.45rem;
  }

  .sources-label {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text-muted);
    margin-right: 0.25rem;
  }

  .source-chip {
    padding: 0.24rem 0.6rem;
    border-radius: 6px;
    font-size: 0.74rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .dossier-card__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--border-subtle);
  }

  .dossier-geo {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .dossier-open-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.68rem 1.25rem;
    border-radius: 999px;
    background: var(--accent-gold-soft);
    border: 1px solid var(--border-gold);
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .dossier-open-btn:hover {
    background: var(--accent-gold);
    color: #090a0d;
  }

  .dossier-soon {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
    .dossier-card {
      padding: 1.5rem;
    }
  }
</style>
