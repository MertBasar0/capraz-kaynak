---
import { ClientRouter } from 'astro:transitions';
import SiteSearchModal from '../components/SiteSearchModal.astro';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Birincil vekâyinâmeler, etkileşimli 3B haritalar ve çapraz kaynak kritiği ile karşılaştırmalı tarih platformu.',
  ogImage = '/images/arsiv/prologue-antioch-bartlett.png',
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const homeHref = withBase('/');
const dossier01Href = withBase('/dosyalar/antakya-1098/');
const dossier02Href = withBase('/dosyalar/hittin-1187/');
const dossier03Href = withBase('/dosyalar/malazgirt-1071/');
const methodologyHref = withBase('/metodoloji/');
const isHome = currentPath === homeHref || currentPath === homeHref.replace(/\/$/, '');
const canonicalUrl = new URL(currentPath, Astro.site || 'https://mertbasar0.github.io').toString();
const ogImageUrl = new URL(
  withBase(ogImage),
  Astro.site || 'https://mertbasar0.github.io'
).toString();
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <ClientRouter />
    <script
      is:inline
      data-astro-transition-persist="goatcounter"
      data-goatcounter="https://mert.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href={homeHref} class="brand" aria-label="Çapraz Kaynak Ana Sayfa">
          <span class="brand__mark" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="26" stroke="#d99b4e" stroke-opacity="0.55" stroke-width="2" />
              <path d="M18 20L46 44M46 20L18 44" stroke="#d99b4e" stroke-width="3.2" stroke-linecap="round" />
              <circle cx="32" cy="32" r="5.5" fill="#d9485f" stroke="#f3ede2" stroke-width="2" />
            </svg>
          </span>
          <span class="brand__text">
            <strong>ÇAPRAZ KAYNAK</strong>
            <small>Karşılaştırmalı Tarih Atlası</small>
          </span>
        </a>

        <nav class="site-nav" aria-label="Ana Gezinme">
          <a href={homeHref} class:list={['site-nav__link', { active: isHome }]}>
            Dosyalar
          </a>
          <a
            href={dossier01Href}
            class:list={['site-nav__link', { active: currentPath.includes('antakya-1098') }]}
          >
            <span class="nav-dosya-short">#</span><span class="nav-dosya-prefix">Dosya </span>01<span class="nav-sublabel">: Antakya 1098</span>
          </a>
          <a
            href={dossier02Href}
            class:list={['site-nav__link', { active: currentPath.includes('hittin-1187') }]}
          >
            <span class="nav-dosya-short">#</span><span class="nav-dosya-prefix">Dosya </span>02<span class="nav-sublabel">: Hıttîn 1187</span>
          </a>
          <a
            href={dossier03Href}
            class:list={['site-nav__link', { active: currentPath.includes('malazgirt-1071') }]}
          >
            <span class="nav-dosya-short">#</span><span class="nav-dosya-prefix">Dosya </span>03<span class="nav-sublabel">: Malazgirt 1071</span>
          </a>
          <a
            href={methodologyHref}
            class:list={['site-nav__link', { active: currentPath.includes('metodoloji') }]}
          >
            Metodoloji
          </a>
          <button
            type="button"
            class="site-search-btn"
            data-open-site-search
            aria-label="Site içi arama (Ctrl+K)"
            title="Tüm dosyalarda ve kaynakçada ara (Ctrl+K veya /)"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="7.2" stroke="currentColor" stroke-width="2.1" />
              <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" />
            </svg>
            <span class="site-search-btn__text">Ara</span>
            <kbd class="site-search-btn__kbd">Ctrl K</kbd>
          </button>
        </nav>
      </div>
      <div class="reading-progress" id="global-reading-progress" aria-hidden="true"></div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <div class="brand__footer-title">ÇAPRAZ KAYNAK</div>
          <p class="site-footer__desc">
            Toplumsal tarih bilinci için açık erişimli, çok cepheli birincil kaynak okumaları. Propaganda ile doğrulanabilir
            olguyu yan yana koyar; okura ne düşüneceğini değil, nasıl sorgulayacağını gösterir.
          </p>
        </div>
        <div class="site-footer__links">
          <a href={homeHref}>Tüm Dosyalar</a>
          <a href={dossier01Href}>Dosya 01: Antakya 1098</a>
          <a href={dossier02Href}>Dosya 02: Hıttîn 1187</a>
          <a href={dossier03Href}>Dosya 03: Malazgirt 1071</a>
          <a href={`${homeHref}#ataturk-kosesi`}>Atatürk Köşesi</a>
          <a href={methodologyHref}>Kaynak Kritiği İlkeleri</a>
          <button type="button" class="footer-search-btn" data-open-site-search>
            Site İçi Arama (Ctrl+K)
          </button>
        </div>
      </div>
    </footer>

    <SiteSearchModal />

    <script>
      let globalScrollCleanup: (() => void) | null = null;

      function initGlobalInteractions() {
        if (globalScrollCleanup) {
          globalScrollCleanup();
          globalScrollCleanup = null;
        }

        const progressEl = document.getElementById('global-reading-progress');
        const updateProgress = () => {
          if (!progressEl) return;
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
          progressEl.style.width = `${ratio}%`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
        globalScrollCleanup = () => window.removeEventListener('scroll', updateProgress);

        const reveals = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.02, rootMargin: '0px 0px -24px 0px' }
          );
          reveals.forEach((el) => io.observe(el));
        } else {
          reveals.forEach((el) => el.classList.add('is-visible'));
        }
      }

      document.addEventListener('astro:page-load', initGlobalInteractions);
      document.addEventListener('astro:before-swap', () => {
        if (globalScrollCleanup) {
          globalScrollCleanup();
          globalScrollCleanup = null;
        }
      });
      document.addEventListener('astro:after-swap', () => {
        const gc = (window as any).goatcounter;
        if (gc && typeof gc.count === 'function') {
          gc.count();
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: rgba(8, 9, 13, 0.78);
    border-bottom: 1px solid var(--border-subtle);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(217, 155, 78, 0.08);
    border: 1px solid rgba(217, 155, 78, 0.25);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand__text strong {
    font-size: 0.88rem;
    letter-spacing: 0.14em;
    color: var(--text-primary);
  }

  .brand__text small {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.32rem;
  }

  .site-nav__link {
    padding: 0.44rem 0.82rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .site-nav__link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .site-nav__link.active {
    color: var(--accent-gold);
    background: var(--accent-gold-soft);
    border: 1px solid var(--border-gold);
  }

  .reading-progress {
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, var(--accent-gold), var(--accent-crimson));
    transition: width 0.08s linear;
  }

  .site-footer {
    border-top: 1px solid var(--border-subtle);
    padding: 3.5rem 0 4rem;
    background: rgba(6, 7, 11, 0.9);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    align-items: flex-start;
  }

  .brand__footer-title {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent-gold);
    margin-bottom: 0.6rem;
  }

  .site-footer__desc {
    max-width: 560px;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
    font-size: 0.86rem;
    color: var(--text-secondary);
  }

  .site-footer__links a:hover {
    color: var(--accent-gold);
  }

  .footer-search-btn {
    padding: 0.34rem 0.72rem;
    border-radius: 999px;
    border: 1px solid rgba(217, 155, 78, 0.35);
    background: rgba(217, 155, 78, 0.08);
    color: var(--accent-gold);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .footer-search-btn:hover {
    background: rgba(217, 155, 78, 0.16);
    border-color: rgba(217, 155, 78, 0.58);
  }

  .site-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.38rem 0.68rem 0.38rem 0.64rem;
    margin-left: 0.18rem;
    border-radius: 999px;
    border: 1px solid rgba(217, 155, 78, 0.34);
    background: rgba(217, 155, 78, 0.08);
    color: var(--accent-gold);
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .site-search-btn:hover {
    background: rgba(217, 155, 78, 0.16);
    border-color: rgba(217, 155, 78, 0.62);
    color: #f6ddb6;
  }

  .site-search-btn__kbd {
    padding: 0.1rem 0.34rem;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .nav-dosya-short {
    display: none;
  }

  @media (max-width: 1180px) {
    .nav-sublabel,
    .site-search-btn__kbd {
      display: none;
    }
    .brand__text small {
      display: none;
    }
    .site-header__inner {
      gap: 0.5rem;
    }
    .site-nav {
      gap: 0.18rem;
    }
    .site-nav__link {
      padding: 0.34rem 0.52rem;
      font-size: 0.74rem;
    }
    .site-search-btn {
      padding: 0.34rem 0.54rem;
      font-size: 0.73rem;
      margin-left: 0.08rem;
    }
  }

  @media (max-width: 680px) {
    .nav-dosya-prefix,
    .site-search-btn__text {
      display: none;
    }
    .nav-dosya-short {
      display: inline;
    }
    .site-header__inner {
      width: min(100% - 1.15rem, var(--max-width));
      gap: 0.3rem;
    }
    .brand {
      gap: 0.35rem;
    }
    .brand__mark {
      width: 26px;
      height: 26px;
    }
    .brand__text strong {
      font-size: 0.61rem;
      letter-spacing: 0.03em;
    }
    .site-nav {
      gap: 0.1rem;
    }
    .site-nav__link {
      padding: 0.26rem 0.33rem;
      font-size: 0.63rem;
    }
    .site-search-btn {
      width: 27px;
      height: 27px;
      padding: 0;
      margin-left: 0.06rem;
      justify-content: center;
    }
  }
</style>
