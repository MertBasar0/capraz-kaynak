---
import { ClientRouter } from 'astro:transitions';
import SiteSearchModal from '../components/SiteSearchModal.astro';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Birincil vekâyinâmeler, etkileşimli 3B haritalar ve çapraz kaynak kritiği ile karşılaştırmalı tarih platformu.',
  ogImage = '/images/arsiv/prologue-antioch-bartlett.png',
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const homeHref = withBase('/');
const dossier01Href = withBase('/dosyalar/antakya-1098/');
const dossier02Href = withBase('/dosyalar/hittin-1187/');
const dossier03Href = withBase('/dosyalar/malazgirt-1071/');
const methodologyHref = withBase('/metodoloji/');
const isHome = currentPath === homeHref || currentPath === homeHref.replace(/\/$/, '');
const canonicalUrl = new URL(currentPath, Astro.site || 'https://mertbasar0.github.io').toString();
const ogImageUrl = new URL(
  withBase(ogImage),
  Astro.site || 'https://mertbasar0.github.io'
).toString();
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var forced = params.get('10kasim');
          var parts = new Intl.DateTimeFormat('en-CA', {
            timeZone: 'Europe/Istanbul',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
          }).formatToParts(new Date());
          var map = {};
          for (var i = 0; i < parts.length; i++) map[parts[i].type] = parts[i].value;
          var isNov10 =
            forced === '1' ? true : forced === '0' ? false : map.month === '11' && map.day === '10';
          var years = Math.max(88, (parseInt(map.year || '2026', 10) || 2026) - 1938);
          var root = document.documentElement;
          root.dataset.mourningYears = String(years);
          if (isNov10) {
            root.setAttribute('data-mourning', '10-kasim');
          } else {
            root.removeAttribute('data-mourning');
          }
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
    <script
      is:inline
      data-astro-transition-persist="goatcounter"
      data-goatcounter="https://mert.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="mourning-ribbon-bar" role="region" aria-label="10 Kasım Atatürk’ü Anma Günü">
        <div class="container mourning-ribbon-bar__inner">
          <div class="mourning-ribbon-bar__left">
            <span class="mourning-ribbon-icon" aria-hidden="true">
              <svg width="14" height="17" viewBox="0 0 24 28" fill="none">
                <path
                  d="M7.5 23.5L12 15.5L16.5 23.5M12 15.5L8.2 9.4C6.8 7.1 8.3 4 11.1 3.7C11.7 3.6 12.3 3.6 12.9 3.7C15.7 4 17.2 7.1 15.8 9.4L12 15.5Z"
                  stroke="#e2e8f0"
                  stroke-width="2.1"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M8.8 8.7C7.8 6.8 9 4.5 11.3 4.3C11.8 4.2 12.2 4.2 12.7 4.3C15 4.5 16.2 6.8 15.2 8.7L12 14.1L8.8 8.7Z"
                  fill="#0b0d13"
                />
              </svg>
            </span>
            <span class="mourning-ribbon-bar__dates">1881 – 1938<span class="mourning-inf"> · 09.05</span></span>
            <span class="mourning-ribbon-bar__sep" aria-hidden="true">|</span>
            <span class="mourning-ribbon-bar__text">
              Cumhuriyetimizin kurucusu <strong>Gazi Mustafa Kemal Atatürk</strong>’ü vefatının{' '}
              <span data-mourning-years-text>88</span>. yılında saygı, özlem ve minnetle anıyoruz.
            </span>
          </div>
          <a href={`${homeHref}#ataturk-kosesi`} class="mourning-ribbon-bar__link">
            <span>10 Kasım Vesikaları</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="container site-header__inner">
        <a href={homeHref} class="brand" aria-label="Çapraz Kaynak Ana Sayfa">
          <span class="brand__mark" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="26" stroke="#d99b4e" stroke-opacity="0.55" stroke-width="2" />
              <path d="M18 20L46 44M46 20L18 44" stroke="#d99b4e" stroke-width="3.2" stroke-linecap="round" />
              <circle cx="32" cy="32" r="5.5" fill="#d9485f" stroke="#f3ede2" stroke-width="2" />
            </svg>
          </span>
          <span class="brand__text">
            <strong>ÇAPRAZ KAYNAK</strong>
            <small>Karşılaştırmalı Tarih Atlası</small>
          </span>
        </a>

        <nav class="site-nav" aria-label="Ana Gezinme">
          <a href={homeHref} class:list={['site-nav__link', { active: isHome }]}>
            Dosyalar
          </a>
          <a
            href={dossier01Href}
            class:list={['site-nav__link', { active: currentPath.includes('antakya-1098') }]}
          >
            <span class="nav-dosya-short">#</span><span class="nav-dosya-prefix">Dosya </span>01<span class="nav-sublabel">: Antakya 1098</span>
          </a>
          <a
            href={dossier02Href}
            class:list={['site-nav__link', { active: currentPath.includes('hittin-1187') }]}
          >
            <span class="nav-dosya-short">#</span><span class="nav-dosya-prefix">Dosya </span>02<span class="nav-sublabel">: Hıttîn 1187</span>
          </a>
          <a
            href={dossier03Href}
            class:list={['site-nav__link', { active: currentPath.includes('malazgirt-1071') }]}
          >
            <span class="nav-dosya-short">#</span><span class="nav-dosya-prefix">Dosya </span>03<span class="nav-sublabel">: Malazgirt 1071</span>
          </a>
          <a
            href={methodologyHref}
            class:list={['site-nav__link', { active: currentPath.includes('metodoloji') }]}
          >
            Metodoloji
          </a>
          <button
            type="button"
            class="site-search-btn"
            data-open-site-search
            aria-label="Site içi arama (Ctrl+K)"
            title="Tüm dosyalarda ve kaynakçada ara (Ctrl+K veya /)"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="7.2" stroke="currentColor" stroke-width="2.1" />
              <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" />
            </svg>
            <span class="site-search-btn__text">Ara</span>
            <kbd class="site-search-btn__kbd">Ctrl K</kbd>
          </button>
        </nav>
      </div>
      <div class="reading-progress" id="global-reading-progress" aria-hidden="true"></div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <div class="brand__footer-title">ÇAPRAZ KAYNAK</div>
          <p class="site-footer__desc">
            Toplumsal tarih bilinci için açık erişimli, çok cepheli birincil kaynak okumaları. Propaganda ile doğrulanabilir
            olguyu yan yana koyar; okura ne düşüneceğini değil, nasıl sorgulayacağını gösterir.
          </p>
        </div>
        <div class="site-footer__links">
          <a href={homeHref}>Tüm Dosyalar</a>
          <a href={dossier01Href}>Dosya 01: Antakya 1098</a>
          <a href={dossier02Href}>Dosya 02: Hıttîn 1187</a>
          <a href={dossier03Href}>Dosya 03: Malazgirt 1071</a>
          <a href={`${homeHref}#ataturk-kosesi`}>Atatürk Köşesi</a>
          <a href={methodologyHref}>Kaynak Kritiği İlkeleri</a>
          <button type="button" class="footer-search-btn" data-open-site-search>
            Site İçi Arama (Ctrl+K)
          </button>
        </div>
      </div>
    </footer>

    <SiteSearchModal />

    <script>
      let globalScrollCleanup: (() => void) | null = null;

      function syncMourningTheme(docRoot: HTMLElement = document.documentElement) {
        try {
          const params = new URLSearchParams(window.location.search);
          const forced = params.get('10kasim');
          const parts = new Intl.DateTimeFormat('en-CA', {
            timeZone: 'Europe/Istanbul',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
          }).formatToParts(new Date());
          const map: Record<string, string> = {};
          for (const p of parts) map[p.type] = p.value;
          const isNov10 =
            forced === '1' ? true : forced === '0' ? false : map.month === '11' && map.day === '10';
          const years = Math.max(88, (parseInt(map.year || '2026', 10) || 2026) - 1938);
          docRoot.dataset.mourningYears = String(years);
          if (isNov10) {
            docRoot.setAttribute('data-mourning', '10-kasim');
          } else {
            docRoot.removeAttribute('data-mourning');
          }
          if (docRoot === document.documentElement) {
            document.querySelectorAll<HTMLElement>('[data-mourning-years-text]').forEach((el) => {
              el.textContent = String(years);
            });
          }
        } catch {
          // ignore
        }
      }

      function initGlobalInteractions() {
        syncMourningTheme(document.documentElement);

        if (globalScrollCleanup) {
          globalScrollCleanup();
          globalScrollCleanup = null;
        }

        const progressEl = document.getElementById('global-reading-progress');
        const updateProgress = () => {
          if (!progressEl) return;
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
          progressEl.style.width = `${ratio}%`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
        globalScrollCleanup = () => window.removeEventListener('scroll', updateProgress);

        const reveals = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.02, rootMargin: '0px 0px -24px 0px' }
          );
          reveals.forEach((el) => io.observe(el));
        } else {
          reveals.forEach((el) => el.classList.add('is-visible'));
        }
      }

      document.addEventListener('astro:page-load', initGlobalInteractions);
      document.addEventListener('astro:before-swap', (ev: any) => {
        if (globalScrollCleanup) {
          globalScrollCleanup();
          globalScrollCleanup = null;
        }
        if (ev?.newDocument?.documentElement) {
          syncMourningTheme(ev.newDocument.documentElement);
        }
      });
      document.addEventListener('astro:after-swap', () => {
        const gc = (window as any).goatcounter;
        if (gc && typeof gc.count === 'function') {
          gc.count();
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: rgba(8, 9, 13, 0.78);
    border-bottom: 1px solid var(--border-subtle);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(217, 155, 78, 0.08);
    border: 1px solid rgba(217, 155, 78, 0.25);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand__text strong {
    font-size: 0.88rem;
    letter-spacing: 0.14em;
    color: var(--text-primary);
  }

  .brand__text small {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.32rem;
  }

  .site-nav__link {
    padding: 0.44rem 0.82rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .site-nav__link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .site-nav__link.active {
    color: var(--accent-gold);
    background: var(--accent-gold-soft);
    border: 1px solid var(--border-gold);
  }

  .reading-progress {
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, var(--accent-gold), var(--accent-crimson));
    transition: width 0.08s linear;
  }

  .site-footer {
    border-top: 1px solid var(--border-subtle);
    padding: 3.5rem 0 4rem;
    background: rgba(6, 7, 11, 0.9);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    align-items: flex-start;
  }

  .brand__footer-title {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent-gold);
    margin-bottom: 0.6rem;
  }

  .site-footer__desc {
    max-width: 560px;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
    font-size: 0.86rem;
    color: var(--text-secondary);
  }

  .site-footer__links a:hover {
    color: var(--accent-gold);
  }

  .footer-search-btn {
    padding: 0.34rem 0.72rem;
    border-radius: 999px;
    border: 1px solid rgba(217, 155, 78, 0.35);
    background: rgba(217, 155, 78, 0.08);
    color: var(--accent-gold);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .footer-search-btn:hover {
    background: rgba(217, 155, 78, 0.16);
    border-color: rgba(217, 155, 78, 0.58);
  }

  .site-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.38rem 0.68rem 0.38rem 0.64rem;
    margin-left: 0.18rem;
    border-radius: 999px;
    border: 1px solid rgba(217, 155, 78, 0.34);
    background: rgba(217, 155, 78, 0.08);
    color: var(--accent-gold);
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .site-search-btn:hover {
    background: rgba(217, 155, 78, 0.16);
    border-color: rgba(217, 155, 78, 0.62);
    color: #f6ddb6;
  }

  .site-search-btn__kbd {
    padding: 0.1rem 0.34rem;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .nav-dosya-short {
    display: none;
  }

  @media (max-width: 1180px) {
    .nav-sublabel,
    .site-search-btn__kbd {
      display: none;
    }
    .brand__text small {
      display: none;
    }
    .site-header__inner {
      gap: 0.5rem;
    }
    .site-nav {
      gap: 0.18rem;
    }
    .site-nav__link {
      padding: 0.34rem 0.52rem;
      font-size: 0.74rem;
    }
    .site-search-btn {
      padding: 0.34rem 0.54rem;
      font-size: 0.73rem;
      margin-left: 0.08rem;
    }
  }

  @media (max-width: 680px) {
    .nav-dosya-prefix,
    .site-search-btn__text {
      display: none;
    }
    .nav-dosya-short {
      display: inline;
    }
    .site-header__inner {
      width: min(100% - 1.15rem, var(--max-width));
      gap: 0.3rem;
    }
    .brand {
      gap: 0.35rem;
    }
    .brand__mark {
      width: 26px;
      height: 26px;
    }
    .brand__text strong {
      font-size: 0.61rem;
      letter-spacing: 0.03em;
    }
    .site-nav {
      gap: 0.1rem;
    }
    .site-nav__link {
      padding: 0.26rem 0.33rem;
      font-size: 0.63rem;
    }
    .site-search-btn {
      width: 27px;
      height: 27px;
      padding: 0;
      margin-left: 0.06rem;
      justify-content: center;
    }
  }

  /* 10 Kasım Anma Şeridi & Gümüş–Obsidyen Üst Menü Atmosferi */
  .mourning-ribbon-bar {
    display: none;
    background: linear-gradient(90deg, rgba(6, 7, 11, 0.97) 0%, rgba(15, 18, 26, 0.97) 50%, rgba(6, 7, 11, 0.97) 100%);
    border-bottom: 1px solid rgba(203, 213, 225, 0.16);
    padding: 0.42rem 0;
    font-size: 0.76rem;
    color: #cbd5e1;
  }

  :global(html[data-mourning='10-kasim']) .mourning-ribbon-bar {
    display: block;
  }

  .mourning-ribbon-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
  }

  .mourning-ribbon-bar__left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .mourning-ribbon-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: rgba(226, 232, 240, 0.07);
    border: 1px solid rgba(226, 232, 240, 0.24);
    flex-shrink: 0;
  }

  .mourning-ribbon-bar__dates {
    font-family: var(--font-serif);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #f1f5f9;
    white-space: nowrap;
  }

  .mourning-inf {
    color: #94a3b8;
    font-weight: 600;
  }

  .mourning-ribbon-bar__sep {
    color: rgba(203, 213, 225, 0.28);
  }

  .mourning-ribbon-bar__text {
    color: #cbd5e1;
    line-height: 1.35;
  }

  .mourning-ribbon-bar__text strong {
    color: #f8fafc;
    font-weight: 600;
  }

  .mourning-ribbon-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(226, 232, 240, 0.26);
    background: rgba(226, 232, 240, 0.07);
    color: #f1f5f9;
    font-size: 0.71rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .mourning-ribbon-bar__link:hover {
    background: rgba(226, 232, 240, 0.16);
    border-color: rgba(241, 245, 249, 0.48);
  }

  :global(html[data-mourning='10-kasim']) .site-header {
    background: rgba(5, 6, 10, 0.86);
    border-bottom-color: rgba(203, 213, 225, 0.14);
  }

  :global(html[data-mourning='10-kasim']) .brand__mark {
    background: rgba(226, 232, 240, 0.06);
    border-color: rgba(226, 232, 240, 0.26);
    filter: grayscale(100%) brightness(1.18);
  }

  :global(html[data-mourning='10-kasim']) .site-nav__link.active {
    color: #f1f5f9;
    background: rgba(226, 232, 240, 0.11);
    border-color: rgba(226, 232, 240, 0.34);
  }

  :global(html[data-mourning='10-kasim']) .site-search-btn,
  :global(html[data-mourning='10-kasim']) .footer-search-btn {
    color: #e2e8f0;
    background: rgba(226, 232, 240, 0.07);
    border-color: rgba(226, 232, 240, 0.3);
  }

  :global(html[data-mourning='10-kasim']) .site-search-btn:hover,
  :global(html[data-mourning='10-kasim']) .footer-search-btn:hover {
    color: #ffffff;
    background: rgba(226, 232, 240, 0.15);
    border-color: rgba(241, 245, 249, 0.52);
  }

  :global(html[data-mourning='10-kasim']) .reading-progress {
    background: linear-gradient(90deg, #94a3b8, #f8fafc);
  }

  :global(html[data-mourning='10-kasim']) .brand__footer-title,
  :global(html[data-mourning='10-kasim']) .site-footer__links a:hover {
    color: #e2e8f0;
  }

  @media (max-width: 920px) {
    .mourning-ribbon-bar__link {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .mourning-ribbon-bar {
      padding: 0.36rem 0;
      font-size: 0.67rem;
    }
    .mourning-ribbon-bar__inner {
